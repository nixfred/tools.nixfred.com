---
// Base layout. Every page passes through here.
//
// Fonts are self hosted through fontsource and bundled into the static
// output. No CDN, no external stylesheet, nothing to block first paint
// or leak a request off this device.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { canonicalUrl } from '../lib/canonicalPath';

interface Props {
  title: string;
  description: string;
  /** Matches the surface blocks in tokens.css. `chassis` is the page
   *  ground; `panel` is the raised interior surface. */
  surface?: 'chassis' | 'panel';
}

const { title, description, surface = 'chassis' } = Astro.props;
// Normalized so canonical, og:url, and the share sheet all agree.
// See src/lib/canonicalPath.ts for why the raw pathname is wrong here.
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-surface={surface}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Hardcoded ONLY here: a meta tag cannot read a CSS custom
         property. This value mirrors --chassis-950 in tokens.css. If
         that token changes, change this with it. -->
    <meta name="theme-color" content="#06080c" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Icons, all self hosted. The SVG is the primary and scales to any
        size. The 32px PNG is the fallback for clients that do not take an
        SVG favicon, and apple-touch-icon is what iOS uses when someone
        adds the site to a home screen. Both PNGs are rasterized from the
        same favicon.svg, so the mark can never drift between them. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Nixfred AI Systems Workbench" />
    <meta property="og:image" content={new URL('/images/og-card.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/images/og-card.jpg', Astro.site)} />
    <!-- The card at /images/og-card.jpg is real and exactly 1200x630. It
         was rendered from an HTML card in a browser and converted with
         sips, the method the factory note here used to describe as a
         TODO. Before this existed every one of these tags advertised a
         404, so any shared link previewed as a broken image. If the
         wordmark or the instrument count on the card ever changes,
         regenerate it; nothing rebuilds it automatically. -->
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />
  </body>
</html>
