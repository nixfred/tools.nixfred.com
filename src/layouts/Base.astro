---
// Base layout. Every page passes through here.
//
// Fonts are self hosted through fontsource and bundled into the static
// output. No CDN, no external stylesheet, nothing to block first paint
// or leak a request off this device.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Matches the surface blocks in tokens.css. `chassis` is the page
   *  ground; `panel` is the raised interior surface. */
  surface?: 'chassis' | 'panel';
}

const { title, description, surface = 'chassis' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-surface={surface}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Hardcoded ONLY here: a meta tag cannot read a CSS custom
         property. This value mirrors --chassis-950 in tokens.css. If
         that token changes, change this with it. -->
    <meta name="theme-color" content="#06080c" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* SVG favicon, self hosted like everything else. Without this the
        browser requests /favicon.ico on every page and logs a 404. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Nixfred AI Systems Workbench" />
    <meta property="og:image" content={new URL('/images/og-card.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/images/og-card.jpg', Astro.site)} />
    <!-- FACTORY NOTE: /images/og-card.jpg does not exist until Stage 2
         generates it (render a 1200x630 card in a browser, capture,
         sips to exact size). Until then these three tags advertise a
         missing image; generate the card before sharing any link. -->
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />
  </body>
</html>
