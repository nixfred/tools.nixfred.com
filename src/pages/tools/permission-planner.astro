---
// Permission Planner.
// PRD: tools-nixfred-prds/tools/09-PERMISSION-PLANNER.md
//
// HONESTY, stated once here because it governs every string this page
// writes: nothing on this page ever calls a grant safe. A finding
// states what a capability allows and what remains possible after the
// grant is narrowed. Least privilege is a direction, not a state.
//
// SHAPE: the PRD workflow is "add resources and actions; assign risk,
// reversibility, data sensitivity, and autonomy level; define approval
// and escalation rules." Each grant below is one row of that resource
// by action matrix, so the input area is a builder: pick an action,
// name a resource, add the row, then fill in its assigned properties.
// Grant cards are created and destroyed by JavaScript, never rebuilt on
// every keystroke, so typing in one field never disturbs another.
import ToolLayout from '../../layouts/ToolLayout.astro';
import ResultPanel from '../../components/kit/ResultPanel.astro';
import HelpNote from '../../components/kit/HelpNote.astro';
import WarningNote from '../../components/kit/WarningNote.astro';
import ExportBar from '../../components/kit/ExportBar.astro';
import EmptyState from '../../components/kit/EmptyState.astro';
import Field from '../../components/kit/Field.astro';
import { getTool } from '../../data/registry';
import { CAPABILITIES, CAPABILITY_IDS, SAMPLES } from '../../lib/tools/permission-planner';

const tool = getTool('permission-planner')!;
---

<ToolLayout tool={tool}>
  <div class="planner" data-planner>
    <div class="toolbar">
      <div class="toolbar-group">
        <label class="label" for="sample">Sample scenario</label>
        <select id="sample" data-sample-select>
          {SAMPLES.map((s) => <option value={s.id}>{s.name}</option>)}
        </select>
        <button type="button" class="btn btn-primary" data-load-sample>
          Load sample
        </button>
      </div>
      <div class="toolbar-group">
        <button type="button" class="btn" data-reset>Reset</button>
      </div>
    </div>

    <p class="teaches" data-teaches role="status" aria-live="polite"></p>

    <Field
      label="What must the agent accomplish"
      name="mission"
      type="textarea"
      rows={2}
      placeholder="State the task in one or two sentences. Blast radius is easier to judge against a stated goal than against a blank one."
    />

    <section class="add-row" aria-labelledby="add-row-heading">
      <h2 id="add-row-heading" class="label">Add a resource and action</h2>
      <div class="add-row-fields">
        <div class="field-inline">
          <label class="label" for="add-action">Action</label>
          <select id="add-action" data-add-action>
            {
              CAPABILITY_IDS.map((id) => (
                <option value={id}>
                  {CAPABILITIES[id].action} (default: {CAPABILITIES[id].defaultResource})
                </option>
              ))
            }
          </select>
        </div>
        <Field
          label="Resource"
          name="add-resource"
          hint="What this grant is about, in a few words. Calendar events, Email inbox, Production database."
          placeholder="e.g. Email inbox"
          id="add-resource"
        />
        <button type="button" class="btn btn-primary" data-add-grant>Add</button>
      </div>
    </section>

    <div class="grants-list" data-grants-list></div>

    <div data-results>
      <WarningNote severity="info" title="Design guidance, not certification">
        Nothing below is a claim that a grant is safe. Each row states
        what a capability allows and what remains possible once the
        grant is narrowed. Least privilege is a direction, not a
        finished state.
      </WarningNote>

      <div class="summary-strip mono" data-summary role="status" aria-live="polite"></div>

      <ResultPanel
        title="Permission matrix, resource by action"
        id="matrix-panel"
        description="Every added grant, sorted worst declared risk first. A human should be able to implement this table directly."
        headingLevel={2}
      >
        <div class="table-scroll" data-matrix></div>
      </ResultPanel>

      <ResultPanel
        title="Findings and recommendations"
        id="findings-panel"
        description="What each grant allows, the narrowest version that still works, and what remains possible either way."
        headingLevel={2}
      >
        <div data-findings></div>
      </ResultPanel>

      <ResultPanel
        title="Dangerous combinations"
        id="combos-panel"
        description="Compound risks, named explicitly with the specific grants responsible, because the combination is the real finding, not the individual grant."
        headingLevel={2}
      >
        <div data-combos></div>
      </ResultPanel>

      <ResultPanel
        title="Audit and alerting"
        id="audit-panel"
        description="What to log and what to alert on for every grant that survives review."
        headingLevel={2}
      >
        <div data-audit></div>
      </ResultPanel>

      <ExportBar formats={['json', 'markdown']} filename="permission-planner-report" />
    </div>

    <div data-empty>
      <EmptyState
        title="No resources or actions added yet"
        body="Add at least one resource and action above, or load a sample to see a full permission matrix, the dangerous combinations it produces, and what a narrower grant would look like."
        sampleLabel="Load the email and calendar assistant sample"
      />
    </div>

    <HelpNote title="Why does nothing here get marked safe">
      <p>
        A permission grant is a bet, not a guarantee. Scoping a
        resource to an allow list, a ceiling, a confirmation step, and
        a reversibility mechanism narrows how often the worst case
        happens and how bad it is when it does. None of that removes
        the worst case from the space of possible outcomes, it only
        makes it less likely and easier to contain.
      </p>
      <p>
        That is why a destructive or externally visible action can
        still be labeled low risk here. The tool does not overrule the
        person filling in the form, since they may know something the
        tool does not. It also does not stay quiet about it. It states
        plainly that the label is disputed and why, and leaves the
        decision on record either way.
      </p>
    </HelpNote>
  </div>
</ToolLayout>

<style>
  .planner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-3);
  }

  .toolbar-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  select {
    background: var(--panel);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    font: inherit;
  }

  .btn {
    font: 600 var(--text-xs) var(--font-sans);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }

  .btn:hover {
    color: var(--accent);
    border-color: var(--signal-edge);
  }

  .btn-primary {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  .btn-primary:hover {
    background: var(--accent-strong);
    color: var(--bg);
  }

  .teaches {
    color: var(--text-faint);
    font-size: var(--text-sm);
    margin: 0;
    min-height: 1.5em;
  }

  .label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .add-row {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-3);
    background: var(--panel);
  }

  .add-row-fields {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .field-inline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .grants-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .table-scroll {
    overflow-x: auto;
  }

  .summary-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-faint);
  }
</style>

{/* Runtime injected markup is NOT reached by Astro scoped CSS, so every
    class the script creates is styled with :global here. This covers
    both the dynamically built grant cards and the result panels. */}
<style is:global>
  .grant-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-3);
    background: var(--panel);
  }

  .grant-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line-faint);
  }

  .grant-action-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0 0 var(--space-1);
  }

  .grant-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .grant-field-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .grant-field-hint {
    font-size: var(--text-sm);
    color: var(--text-faint);
    margin: 0;
  }

  .grant-control {
    width: 100%;
    font-family: var(--font-mono);
    color: var(--text);
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.55rem 0.7rem;
    line-height: 1.5;
  }

  .grant-control:focus {
    border-color: var(--accent);
    background: var(--bg);
  }

  .grant-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .grant-toggles {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .toggle {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
    cursor: pointer;
  }

  .remove-grant {
    font: 600 var(--text-xs) var(--font-sans);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--status-alert);
    background: transparent;
    border: 1px solid var(--status-alert);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }

  .remove-grant:hover {
    background: var(--panel-raised);
  }

  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .matrix-table th,
  .matrix-table td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--line-faint);
    white-space: nowrap;
  }

  .matrix-table th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .severity-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
  }

  .severity-tag[data-severity='low'] {
    color: var(--status-queued);
    border-color: var(--status-queued);
  }

  .severity-tag[data-severity='medium'] {
    color: var(--status-beta);
    border-color: var(--status-beta);
  }

  .severity-tag[data-severity='high'],
  .severity-tag[data-severity='critical'] {
    color: var(--status-alert);
    border-color: var(--status-alert);
  }

  .severity-tag[data-severity='critical'] {
    border-width: 2px;
    font-weight: 700;
  }

  .risk-differs {
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: var(--status-beta);
  }

  .wildcard-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--status-alert);
  }

  .finding-card {
    border: 1px solid var(--line);
    border-left-width: 3px;
    border-radius: var(--radius);
    padding: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .finding-card[data-severity='low'] {
    border-left-color: var(--status-queued);
  }

  .finding-card[data-severity='medium'] {
    border-left-color: var(--status-beta);
  }

  .finding-card[data-severity='high'],
  .finding-card[data-severity='critical'] {
    border-left-color: var(--status-alert);
  }

  .finding-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .finding-title {
    font-weight: 700;
    color: var(--text);
  }

  .finding-facts {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-dim);
    margin: 0 0 var(--space-2);
  }

  .finding-outcome,
  .finding-containment,
  .finding-remains {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
    max-width: none;
  }

  .finding-remains {
    color: var(--text-faint);
    font-style: italic;
  }

  .warning-line {
    display: block;
    font-size: var(--text-sm);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
    border-left: 2px solid var(--status-alert);
    background: var(--panel-raised);
    color: var(--text-muted);
  }

  .warning-line[data-severity='warning'] {
    border-left-color: var(--status-beta);
  }

  .rec-list {
    margin: 0;
    padding-left: 1.2rem;
  }

  .rec-list li {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .rec-reason {
    display: block;
    color: var(--text-faint);
    font-size: var(--text-sm);
  }

  .combo-card {
    border: 1px solid var(--status-alert);
    border-left-width: 3px;
    border-radius: var(--radius);
    padding: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .combo-name {
    font-weight: 700;
    color: var(--status-alert);
    margin: 0 0 var(--space-1);
  }

  .combo-involves {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-dim);
    margin: 0 0 var(--space-2);
  }

  .clean-note {
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  .audit-block {
    margin-bottom: var(--space-3);
  }

  .audit-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0 0 var(--space-1);
  }

  .audit-list {
    margin: 0;
    padding-left: 1.2rem;
  }

  .audit-list li {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>

<script>
  import {
    CAPABILITIES,
    CAPABILITY_IDS,
    SAMPLES,
    SEVERITY_ORDER,
    SEVERITY_LABELS,
    DATA_SENSITIVITIES,
    DATA_SENSITIVITY_LABELS,
    AUTONOMY_LEVELS,
    AUTONOMY_LEVEL_LABELS,
    analyze,
    sampleState,
    emptyState,
    getSample,
    serialize,
    defaultGrant,
    type CapabilityId,
    type Grant,
    type PlannerState,
    type PlannerAnalysis,
  } from '../../lib/tools/permission-planner';

  const root = document.querySelector<HTMLElement>('[data-planner]');
  if (root) {
    const el = <T extends Element>(sel: string) => root.querySelector<T>(sel);
    const grantsList = el<HTMLElement>('[data-grants-list]');

    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    let nextGrantId = 0;
    const newGrantId = () => `grant-${nextGrantId++}`;

    /* ---------------------------------------------------------------
     * Grant card construction. Runs only on structural changes: add,
     * remove, load sample, reset. Never on a keystroke, so typing in
     * one field never rebuilds the DOM out from under the user.
     * ------------------------------------------------------------- */
    function selectOptions<T extends string>(values: T[], labels: Record<T, string>, selected: T) {
      return values
        .map((v) => `<option value="${esc(v)}" ${v === selected ? 'selected' : ''}>${esc(labels[v])}</option>`)
        .join('');
    }

    function grantCardHTML(grant: Grant): string {
      const trait = CAPABILITIES[grant.capabilityId];
      const g = grant.id;
      return `
      <div class="grant-card" data-grant-card data-grant-id="${esc(g)}" data-capability-id="${esc(grant.capabilityId)}">
        <div class="grant-card-head">
          <div>
            <p class="grant-action-tag">${esc(trait.action)}</p>
            <div class="grant-field" style="margin-bottom:0">
              <label class="grant-field-label" for="resource-${esc(g)}">Resource</label>
              <input class="grant-control" id="resource-${esc(g)}" data-field="resource" type="text" value="${esc(grant.resource)}" placeholder="${esc(trait.defaultResource)}" />
            </div>
          </div>
          <button type="button" class="remove-grant" data-remove-grant>Remove</button>
        </div>

        <div class="grant-grid">
          <div class="grant-field">
            <label class="grant-field-label" for="scope-${esc(g)}">Scope</label>
            <input class="grant-control" id="scope-${esc(g)}" data-field="scope" type="text" value="${esc(grant.scope)}" placeholder="e.g. read-only, this resource only" />
            <p class="grant-field-hint">Name the exact ${esc(trait.targetNoun)} this task needs. Empty or "*" reads as wildcard access.</p>
          </div>
          <div class="grant-field">
            <label class="grant-field-label" for="ceiling-${esc(g)}">Rate or amount ceiling</label>
            <input class="grant-control" id="ceiling-${esc(g)}" data-field="ceiling" type="text" value="${esc(grant.ceiling)}" placeholder="e.g. 20 per day, or $50 per transaction" />
          </div>
          <div class="grant-field">
            <label class="grant-field-label" for="risk-${esc(g)}">Declared risk</label>
            <select class="grant-control" id="risk-${esc(g)}" data-field="risk">
              ${selectOptions(SEVERITY_ORDER, SEVERITY_LABELS, grant.risk)}
            </select>
          </div>
          <div class="grant-field">
            <label class="grant-field-label" for="sensitivity-${esc(g)}">Data sensitivity</label>
            <select class="grant-control" id="sensitivity-${esc(g)}" data-field="dataSensitivity">
              ${selectOptions(DATA_SENSITIVITIES, DATA_SENSITIVITY_LABELS, grant.dataSensitivity)}
            </select>
          </div>
          <div class="grant-field">
            <label class="grant-field-label" for="autonomy-${esc(g)}">Autonomy level</label>
            <select class="grant-control" id="autonomy-${esc(g)}" data-field="autonomyLevel">
              ${selectOptions(AUTONOMY_LEVELS, AUTONOMY_LEVEL_LABELS, grant.autonomyLevel)}
            </select>
          </div>
          <div class="grant-field">
            <label class="grant-field-label" for="approval-${esc(g)}">Approval rule</label>
            <input class="grant-control" id="approval-${esc(g)}" data-field="approvalRule" type="text" value="${esc(grant.approvalRule)}" placeholder="Who or what approves this" />
          </div>
          <div class="grant-field">
            <label class="grant-field-label" for="escalation-${esc(g)}">Escalation rule</label>
            <input class="grant-control" id="escalation-${esc(g)}" data-field="escalationRule" type="text" value="${esc(grant.escalationRule)}" placeholder="What happens if this fires outside the pattern" />
          </div>
        </div>

        <div class="grant-toggles">
          <label class="toggle">
            <input type="checkbox" data-field="requiresConfirmation" ${grant.requiresConfirmation ? 'checked' : ''} />
            Requires confirmation before it fires
          </label>
          ${
            trait.supportsDryRun
              ? `<label class="toggle"><input type="checkbox" data-field="dryRunFirst" ${grant.dryRunFirst ? 'checked' : ''} /> Requires a dry run first</label>`
              : ''
          }
          ${
            trait.canBeMadeReversible
              ? `<label class="toggle"><input type="checkbox" data-field="reversibleOverride" ${grant.reversibleOverride ? 'checked' : ''} /> Made reversible: ${esc(trait.reversibleApproach)}</label>`
              : ''
          }
        </div>
      </div>`;
    }

    function addGrantCard(grant: Grant) {
      if (!grantsList) return;
      grantsList.insertAdjacentHTML('beforeend', grantCardHTML(grant));
    }

    function rebuildGrantCards(grants: Grant[]) {
      if (!grantsList) return;
      grantsList.innerHTML = grants.map((g) => grantCardHTML(g)).join('');
    }

    /* ---------------------------------------------------------------
     * State reading. Every value comes from the live DOM, never from a
     * cached copy, so the results always match what is on screen.
     * ------------------------------------------------------------- */
    function readGrant(card: HTMLElement): Grant {
      const field = <T extends HTMLInputElement | HTMLSelectElement>(name: string) =>
        card.querySelector<T>(`[data-field="${name}"]`);
      return {
        id: card.dataset.grantId ?? '',
        capabilityId: (card.dataset.capabilityId ?? 'read-files') as CapabilityId,
        resource: field<HTMLInputElement>('resource')?.value ?? '',
        scope: field<HTMLInputElement>('scope')?.value ?? '',
        ceiling: field<HTMLInputElement>('ceiling')?.value ?? '',
        risk: (field<HTMLSelectElement>('risk')?.value as Grant['risk']) ?? 'medium',
        dataSensitivity: (field<HTMLSelectElement>('dataSensitivity')?.value as Grant['dataSensitivity']) ?? 'none',
        autonomyLevel: (field<HTMLSelectElement>('autonomyLevel')?.value as Grant['autonomyLevel']) ?? 'acts-with-confirmation',
        requiresConfirmation: field<HTMLInputElement>('requiresConfirmation')?.checked ?? false,
        approvalRule: field<HTMLInputElement>('approvalRule')?.value ?? '',
        escalationRule: field<HTMLInputElement>('escalationRule')?.value ?? '',
        dryRunFirst: field<HTMLInputElement>('dryRunFirst')?.checked ?? false,
        reversibleOverride: field<HTMLInputElement>('reversibleOverride')?.checked ?? false,
      };
    }

    function readState(): PlannerState {
      const mission = el<HTMLTextAreaElement>('[name="mission"]')?.value ?? '';
      const cards = grantsList ? Array.from(grantsList.querySelectorAll<HTMLElement>('[data-grant-card]')) : [];
      return {
        mission,
        grants: cards.map(readGrant),
        scenarioId: el<HTMLSelectElement>('[data-sample-select]')?.value ?? SAMPLES[0].id,
      };
    }

    /* ---------------------------------------------------------------
     * Result rendering. Reads state fresh and rewrites only the result
     * panels, never the grant cards themselves.
     * ------------------------------------------------------------- */
    function renderSummary(analysis: PlannerAnalysis) {
      const target = el('[data-summary]');
      if (!target) return;
      const parts = SEVERITY_ORDER.map((s) => `<span>${esc(SEVERITY_LABELS[s])}: ${analysis.riskCounts[s]}</span>`);
      parts.push(`<span>Wildcard grants: ${analysis.wildcardCount}</span>`);
      parts.push(`<span>Declared differs from assessed: ${analysis.riskMismatchCount}</span>`);
      target.innerHTML = parts.join('');
    }

    function renderMatrix(analysis: PlannerAnalysis) {
      const target = el('[data-matrix]');
      if (!target) return;
      const rank: Record<string, number> = { critical: 0, high: 1, medium: 2, low: 3 };
      const sorted = [...analysis.findings].sort((a, b) => rank[a.grant.risk] - rank[b.grant.risk]);

      const rows = sorted
        .map((f) => {
          const trait = CAPABILITIES[f.grant.capabilityId];
          const differs = f.grant.risk !== f.blast.severity;
          return `
        <tr>
          <td>${esc(trait.action)}</td>
          <td>${esc(f.grant.resource || trait.defaultResource)}</td>
          <td><span class="severity-tag" data-severity="${f.grant.risk}">${esc(SEVERITY_LABELS[f.grant.risk])}</span></td>
          <td class="${differs ? 'risk-differs' : ''}">${esc(SEVERITY_LABELS[f.blast.severity])}</td>
          <td>${esc(f.blast.reversibility)}</td>
          <td>${esc(DATA_SENSITIVITY_LABELS[f.grant.dataSensitivity])}</td>
          <td>${esc(AUTONOMY_LEVEL_LABELS[f.grant.autonomyLevel])}</td>
          <td>${f.wildcard ? '<span class="wildcard-tag">wildcard</span>' : esc(f.grant.scope.trim() || '(unscoped)')}</td>
        </tr>`;
        })
        .join('');

      target.innerHTML = `
        <table class="matrix-table">
          <thead>
            <tr>
              <th>Action</th><th>Resource</th><th>Risk</th><th>Assessed</th>
              <th>Reversibility</th><th>Data sensitivity</th><th>Autonomy</th><th>Scope</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>`;
    }

    function renderFindings(analysis: PlannerAnalysis) {
      const target = el('[data-findings]');
      if (!target) return;
      if (!analysis.findings.length) {
        target.innerHTML = '<p class="clean-note">No resource or action added.</p>';
        return;
      }

      target.innerHTML = analysis.findings
        .map((f) => {
          const warnings = f.warnings
            .map((w) => `<span class="warning-line" data-severity="${w.severity}">${esc(w.message)}</span>`)
            .join('');
          const recs = f.recommendations.length
            ? `<ul class="rec-list">${f.recommendations
                .map((r) => `<li>${esc(r.action)}<span class="rec-reason">${esc(r.reason)}</span></li>`)
                .join('')}</ul>`
            : '<p class="clean-note">No further narrowing rule fired for this grant.</p>';

          return `
        <div class="finding-card" data-severity="${f.grant.risk}">
          <div class="finding-head">
            <span class="finding-title">${esc(f.label)}</span>
            <span class="severity-tag" data-severity="${f.grant.risk}">${esc(SEVERITY_LABELS[f.grant.risk])} declared</span>
          </div>
          <p class="finding-facts">Assessed severity: ${esc(SEVERITY_LABELS[f.blast.severity])}. Reversibility: ${esc(f.blast.reversibility)}. Detectability: ${esc(f.blast.detectability)}.</p>
          <p class="finding-outcome">${esc(f.blast.worstOutcome)}</p>
          <p class="finding-containment">${esc(f.blast.containment)}</p>
          ${warnings}
          ${recs}
          <p class="finding-remains">${esc(f.whatRemainsPossible)}</p>
        </div>`;
        })
        .join('');
    }

    function renderCombos(analysis: PlannerAnalysis) {
      const target = el('[data-combos]');
      if (!target) return;
      if (!analysis.combos.length) {
        target.innerHTML =
          '<p class="clean-note">None of the three named compound risks matched this configuration. That states what did not match, not that the configuration carries no risk.</p>';
        return;
      }
      target.innerHTML = analysis.combos
        .map(
          (c) => `
        <div class="combo-card">
          <p class="combo-name">${esc(c.name)}</p>
          <p class="combo-involves">${c.triggeringGrants.map((g) => esc(g.label)).join(' + ')}</p>
          <p>${esc(c.message)}</p>
        </div>`,
        )
        .join('');
    }

    function renderAudit(analysis: PlannerAnalysis) {
      const target = el('[data-audit]');
      if (!target) return;
      if (!analysis.auditLog.length) {
        target.innerHTML = '<p class="clean-note">No resource or action added.</p>';
        return;
      }
      target.innerHTML = analysis.auditLog
        .map(
          (a) => `
        <div class="audit-block">
          <p class="audit-title">${esc(a.label)}</p>
          <ul class="audit-list">${a.log.map((line) => `<li>${esc(line)}</li>`).join('')}</ul>
        </div>`,
        )
        .join('');
    }

    function updateResults() {
      const state = readState();
      const analysis = analyze(state);

      const results = el<HTMLElement>('[data-results]');
      const empty = el<HTMLElement>('[data-empty]');
      const hasGrants = analysis.findings.length > 0;
      if (results) results.hidden = !hasGrants;
      if (empty) empty.hidden = hasGrants;

      if (hasGrants) {
        renderSummary(analysis);
        renderMatrix(analysis);
        renderFindings(analysis);
        renderCombos(analysis);
        renderAudit(analysis);
      }
    }

    /* ---------------------------------------------------------------
     * Wiring
     * ------------------------------------------------------------- */
    // Typing or toggling any grant field never rebuilds a card, it only
    // re-renders the results below.
    root.addEventListener('input', updateResults);
    root.addEventListener('change', updateResults);

    root.addEventListener('click', (event) => {
      const removeBtn = (event.target as HTMLElement)?.closest<HTMLElement>('[data-remove-grant]');
      if (removeBtn) {
        removeBtn.closest('[data-grant-card]')?.remove();
        updateResults();
      }
    });

    el('[data-add-grant]')?.addEventListener('click', () => {
      const action = el<HTMLSelectElement>('[data-add-action]')?.value as CapabilityId | undefined;
      const resourceField = el<HTMLInputElement>('#add-resource');
      if (!action) return;
      const resource = resourceField?.value.trim() ?? '';
      addGrantCard(defaultGrant(newGrantId(), action, resource));
      if (resourceField) resourceField.value = '';
      updateResults();
    });

    el('[data-load-sample]')?.addEventListener('click', () => {
      const id = el<HTMLSelectElement>('[data-sample-select]')?.value ?? SAMPLES[0].id;
      const state = sampleState(id);
      const mission = el<HTMLTextAreaElement>('[name="mission"]');
      if (mission) mission.value = state.mission;
      rebuildGrantCards(state.grants);
      const teaches = el('[data-teaches]');
      if (teaches) teaches.textContent = getSample(id)?.teaches ?? '';
      updateResults();
    });

    el('[data-reset]')?.addEventListener('click', () => {
      const state = emptyState();
      const mission = el<HTMLTextAreaElement>('[name="mission"]');
      if (mission) mission.value = state.mission;
      rebuildGrantCards(state.grants);
      const teaches = el('[data-teaches]');
      if (teaches) teaches.textContent = '';
      updateResults();
    });

    // EmptyState's sample button dispatches this. Loads the required
    // email and calendar sample regardless of what the select shows.
    root.addEventListener('workbench:load-sample', () => {
      const select = el<HTMLSelectElement>('[data-sample-select]');
      if (select) select.value = 'email-calendar-assistant';
      const state = sampleState('email-calendar-assistant');
      const mission = el<HTMLTextAreaElement>('[name="mission"]');
      if (mission) mission.value = state.mission;
      rebuildGrantCards(state.grants);
      const teaches = el('[data-teaches]');
      if (teaches) teaches.textContent = getSample('email-calendar-assistant')?.teaches ?? '';
      updateResults();
    });

    // ExportBar asks; the tool answers. See src/components/kit/ExportBar.astro.
    root.addEventListener('workbench:export', ((event: CustomEvent) => {
      const { format, resolve } = event.detail ?? {};
      if (typeof resolve !== 'function') return;
      const fmt = format === 'markdown' ? 'markdown' : 'json';
      resolve(serialize(readState(), fmt));
    }) as EventListener);

    updateResults();
  }
</script>
