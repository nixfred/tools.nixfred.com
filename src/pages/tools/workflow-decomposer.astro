  .steps-list[hidden] {
    display: none;
  }

  .steps-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .counts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: var(--space-3);
  }

  .order-list {
    margin: 0 0 var(--space-3);
    padding-left: 1.2rem;
  }

  .method {
    font-size: var(--text-xs);
    color: var(--text-dim);
    margin: 0 0 var(--space-3);
  }

  .agent-export {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
