</style>

<script>
  import type { ProcessState, Step, StepProperties, StepPropertyKey } from '../../lib/tools/workflow-decomposer';
  import {
    analyzeProcess,
    sampleState,
    emptyState,
    getSample,
    serialize,
    validate,
    buildAgentDesignerPayload,
    SAMPLES,
    FREQUENCY_LEVELS,
    FREQUENCY_LABELS,
    COST_LEVELS,
    COST_LABELS,
    CLASSIFICATION_LABELS,
    GRAPH_ISSUE_LABELS,
    PROPERTY_LABELS,
    PRIORITY_SCORE_METHOD,
    DEFAULT_PROPERTIES,
  } from '../../lib/tools/workflow-decomposer';

  const root = document.querySelector<HTMLElement>('[data-decomposer]');
  if (root) {
    const el = <T extends Element>(sel: string) => root.querySelector<T>(sel);
    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    let state: ProcessState = emptyState();

    const newStepId = (): string =>
      typeof crypto !== 'undefined' && 'randomUUID' in crypto
        ? crypto.randomUUID()
        : `step-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;

    const slugifyLocal = (text: string): string => {
      const slug = text.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      return slug || 'workflow-decomposer';
    };

    const emptyWrapper = el<HTMLElement>('[data-empty-wrapper]');
    const stepsList = el<HTMLOListElement>('[data-steps-list]');
    const outcomeInput = el<HTMLInputElement>('#field-outcome');
    const inputsInput = el<HTMLTextAreaElement>('#field-inputs');
    const constraintsInput = el<HTMLTextAreaElement>('#field-constraints');

    /* ---- Focus preservation across a full re-render ---------------- */
    interface FocusMark {
      stepId: string;
      field: string;
      selectionStart: number | null;
      selectionEnd: number | null;
    }

    function captureFocus(): FocusMark | null {
      const active = document.activeElement;
      if (!active || !(active instanceof HTMLElement) || !root!.contains(active)) return null;
      const card = active.closest<HTMLElement>('[data-step-card]');
      const field = active.getAttribute('data-step-field');
      if (!card || !field) return null;
      const withSelection = active as HTMLInputElement | HTMLTextAreaElement;
      return {
        stepId: card.dataset.stepId ?? '',
        field,
        selectionStart: 'selectionStart' in withSelection ? withSelection.selectionStart : null,
        selectionEnd: 'selectionEnd' in withSelection ? withSelection.selectionEnd : null,
      };
    }

    function restoreFocus(mark: FocusMark | null) {
      if (!mark) return;
      const target = root!.querySelector<HTMLElement>(
        `[data-step-card][data-step-id="${mark.stepId}"] [data-step-field="${mark.field}"]`,
      );
      if (!target) return;
      target.focus();
      if (mark.selectionStart !== null && 'setSelectionRange' in target) {
        try {
          (target as HTMLInputElement).setSelectionRange(mark.selectionStart, mark.selectionEnd ?? mark.selectionStart);
        } catch {
          // Some input types refuse setSelectionRange. Focus already landed.
        }
      }
    }

    /* ---- Rendering the step editor ---------------------------------- */
    const boolField = (
      stepId: string,
      field: keyof StepProperties,
      label: string,
      value: boolean,
    ) => `
      <div class="mini-field">
        <label class="mini-label" for="${stepId}-${field}">${esc(label)}</label>
        <select class="mini-control" id="${stepId}-${field}" data-step-id="${stepId}" data-step-field="${field}" data-step-kind="bool">
          <option value="true" ${value ? 'selected' : ''}>Yes</option>
          <option value="false" ${!value ? 'selected' : ''}>No</option>
        </select>
      </div>`;

    function renderStepCard(step: Step, index: number, all: Step[], levels: Map<string, string>): string {
      const level = levels.get(step.id) ?? '';
      const others = all.filter((s) => s.id !== step.id);
      const dependsBody = others.length
        ? `<div class="depends-options">${others
            .map(
              (s) => `
          <label class="depends-option">
            <input
              type="checkbox"
              class="depends-checkbox"
              data-step-id="${esc(step.id)}"
              data-step-field="dependsOn"
              data-depends-on-id="${esc(s.id)}"
              ${step.dependsOn.includes(s.id) ? 'checked' : ''}
            />
            ${esc(s.name || s.id)}
          </label>`,
            )
            .join('')}</div>`
        : '<p class="depends-empty">No other steps yet. This step starts the process.</p>';

      return `
      <li class="step-card" data-step-card data-step-id="${esc(step.id)}">
        <div class="step-card-head">
          <span class="step-index mono">Step ${index + 1}</span>
          <span class="step-badge" data-level="${esc(level)}">${esc(CLASSIFICATION_LABELS[level as keyof typeof CLASSIFICATION_LABELS] ?? level)}</span>
          <div class="step-actions">
            <button type="button" data-move-up data-step-id="${esc(step.id)}" ${index === 0 ? 'disabled' : ''} aria-label="Move step ${index + 1} earlier">Up</button>
            <button type="button" data-move-down data-step-id="${esc(step.id)}" ${index + 1 === all.length ? 'disabled' : ''} aria-label="Move step ${index + 1} later">Down</button>
            <button type="button" data-remove-step data-step-id="${esc(step.id)}" aria-label="Remove step ${index + 1}">Remove</button>
          </div>
        </div>

        <div class="step-grid">
          <div class="mini-field wide">
            <label class="mini-label" for="${step.id}-name">Step name</label>
            <input class="mini-control" id="${step.id}-name" type="text" data-step-id="${step.id}" data-step-field="name" value="${esc(step.name)}" autocomplete="off" spellcheck="false" />
          </div>
          <div class="mini-field">
            <label class="mini-label" for="${step.id}-owner">Owner today</label>
            <input class="mini-control" id="${step.id}-owner" type="text" data-step-id="${step.id}" data-step-field="owner" value="${esc(step.owner)}" autocomplete="off" spellcheck="false" />
          </div>
          <div class="mini-field wide">
            <label class="mini-label" for="${step.id}-completionEvidence">Completion evidence</label>
            <textarea class="mini-control" id="${step.id}-completionEvidence" rows="2" data-step-id="${step.id}" data-step-field="completionEvidence" spellcheck="false">${esc(step.completionEvidence)}</textarea>
          </div>
          <fieldset class="depends-fieldset">
            <legend>Depends on</legend>
            ${dependsBody}
          </fieldset>
        </div>

        <p class="properties-title">Properties that decide automatability</p>
        <div class="step-grid">
          ${boolField(step.id, 'inputStructured', 'Input is structured', step.properties.inputStructured)}
          ${boolField(step.id, 'outputVerifiable', 'Output is verifiable', step.properties.outputVerifiable)}
          ${boolField(step.id, 'reversible', 'Action is reversible', step.properties.reversible)}
          ${boolField(step.id, 'needsJudgment', 'Needs human judgment', step.properties.needsJudgment)}
          ${boolField(step.id, 'legalFinancialRisk', 'Legal or financial risk', step.properties.legalFinancialRisk)}
          <div class="mini-field">
            <label class="mini-label" for="${step.id}-frequency">How often it runs</label>
            <select class="mini-control" id="${step.id}-frequency" data-step-id="${step.id}" data-step-field="frequency">
              ${FREQUENCY_LEVELS.map((f) => `<option value="${f}" ${step.properties.frequency === f ? 'selected' : ''}>${esc(FREQUENCY_LABELS[f])}</option>`).join('')}
            </select>
          </div>
          <div class="mini-field">
            <label class="mini-label" for="${step.id}-mistakeCost">Cost of a mistake</label>
            <select class="mini-control" id="${step.id}-mistakeCost" data-step-id="${step.id}" data-step-field="mistakeCost">
              ${COST_LEVELS.map((c) => `<option value="${c}" ${step.properties.mistakeCost === c ? 'selected' : ''}>${esc(COST_LABELS[c])}</option>`).join('')}
            </select>
          </div>
        </div>
      </li>`;
    }

    function renderSteps(levels: Map<string, string>) {
      if (!stepsList || !emptyWrapper) return;

      const hasSteps = state.steps.length > 0;
      // The empty state is the real kit component, rendered once on the
      // server. Its own "load a sample" button already dispatches
      // workbench:load-sample, which the listener near the bottom of
      // this script answers, so nothing here duplicates its markup.
      emptyWrapper.hidden = hasSteps;
      stepsList.hidden = !hasSteps;

      if (!hasSteps) {
        stepsList.innerHTML = '';
        return;
      }

      stepsList.innerHTML = state.steps
        .map((step, index) => renderStepCard(step, index, state.steps, levels))
        .join('');
    }

    /* ---- Rendering results -------------------------------------------- */
    function renderClassifications(analysis: ReturnType<typeof analyzeProcess>) {
      const counts = el('[data-level-counts]');
      const target = el('[data-classifications]');
      if (!counts || !target) return;

      counts.innerHTML = Object.entries(analysis.levelCounts)
        .map(([level, n]) => `<span>${esc(CLASSIFICATION_LABELS[level as keyof typeof CLASSIFICATION_LABELS])}: ${n}</span>`)
        .join('');

      if (state.steps.length === 0) {
        target.innerHTML = '<p class="clean-note">Add a step to see it classified.</p>';
        return;
      }

      target.innerHTML = state.steps
        .map((step, index) => {
          const c = analysis.classifications.get(step.id);
          if (!c) return '';
          const contributing = c.contributingFactors.length
            ? `<p class="classification-contributing">Also weighed: ${c.contributingFactors.map((f) => esc(PROPERTY_LABELS[f as StepPropertyKey])).join(', ')}.</p>`
            : '';
          return `
          <div class="classification-row">
            <div class="classification-head">
              <span class="classification-index mono">${index + 1}</span>
              <strong class="classification-name">${esc(step.name || step.id)}</strong>
              <span class="classification-badge" data-level="${c.level}">${esc(CLASSIFICATION_LABELS[c.level])}</span>
            </div>
            <p class="classification-reason">${esc(c.reason)}</p>
            ${contributing}
          </div>`;
        })
        .join('');
    }

    function renderCompleteness() {
      const target = el('[data-completeness]');
      if (!target) return;
      const issues = validate(state).filter((i) => i.field !== 'steps');
      if (!issues.length) {
        target.innerHTML = state.steps.length
          ? '<p class="clean-note">Every step has a name, an owner, and completion evidence.</p>'
          : '<p class="clean-note">Add a step to check its completeness.</p>';
        return;
      }
      target.innerHTML = issues
        .map(
          (i) => `
        <div class="issue-row">
          <span class="issue-kind mono">${i.severity === 'error' ? 'Error' : 'Incomplete'}</span>
          <p>${esc(i.message)}</p>
        </div>`,
        )
        .join('');
    }

    function renderGraphIssues(analysis: ReturnType<typeof analyzeProcess>) {
      const target = el('[data-graph-issues]');
      if (!target) return;
      if (!analysis.graphIssues.length) {
        target.innerHTML = '<p class="clean-note">No cycles, orphan steps, or broken dependencies detected.</p>';
        return;
      }
      target.innerHTML = analysis.graphIssues
        .map(
          (issue) => `
        <div class="issue-row">
          <span class="issue-kind mono">${esc(GRAPH_ISSUE_LABELS[issue.kind])}</span>
          <p>${esc(issue.message)}</p>
        </div>`,
        )
        .join('');
    }

    function renderHandoffs(analysis: ReturnType<typeof analyzeProcess>) {
      const target = el('[data-handoffs]');
      if (!target) return;
      if (!analysis.handoffs.length) {
        target.innerHTML =
          '<p class="clean-note">No edge in this process crosses from a system to a person or back.</p>';
        return;
      }
      target.innerHTML = analysis.handoffs
        .map((h) => `<div class="handoff-row"><p>${esc(h.message)}</p></div>`)
        .join('');
    }

    function renderSilentFailures(analysis: ReturnType<typeof analyzeProcess>) {
      const target = el('[data-silent-failures]');
      if (!target) return;
      if (!analysis.silentFailureRisks.length) {
        target.innerHTML = '<p class="clean-note">No step with an unverifiable result feeds a later step.</p>';
        return;
      }
      target.innerHTML = analysis.silentFailureRisks
        .map((s) => `<div class="silent-row"><p>${esc(s.message)}</p></div>`)
        .join('');
    }

    function renderApprovalPoints(analysis: ReturnType<typeof analyzeProcess>) {
      const target = el('[data-approval-points]');
      if (!target) return;
      if (!analysis.approvalPoints.length) {
        target.innerHTML = '<p class="clean-note">Nothing in this process currently requires a human sign off.</p>';
        return;
      }
      target.innerHTML = analysis.approvalPoints
        .map(
          (p) => `
        <div class="approval-row">
          <strong class="approval-name">${esc(p.name)}</strong>
          <p>${esc(p.reason)}</p>
        </div>`,
        )
        .join('');
    }

    function renderActors(analysis: ReturnType<typeof analyzeProcess>) {
      const target = el('[data-actors]');
      if (!target) return;
      target.textContent = analysis.actors.length ? analysis.actors.join(', ') : 'No owners stated yet.';
    }

    function renderOrder(analysis: ReturnType<typeof analyzeProcess>) {
      const target = el('[data-order-list]');
      const method = el('[data-order-method]');
      if (!target) return;
      const byId = new Map(state.steps.map((s) => [s.id, s]));

      if (!analysis.implementationOrder.length) {
        target.innerHTML =
          '<li class="clean-note">No step is classified automate now or automate with a checkpoint yet.</li>';
      } else {
        target.innerHTML = analysis.implementationOrder
          .map((entry, index) => {
            const step = byId.get(entry.stepId);
            return `<li>
              <span class="mono">#${index + 1}</span>
              <strong>${esc(step?.name || entry.stepId)}</strong>
              <span class="order-score mono">score ${entry.score} = ${entry.frequencyWeight} &times; ${entry.costWeight} minus ${entry.riskPenalty}</span>
            </li>`;
          })
          .join('');
      }
      if (method) method.textContent = PRIORITY_SCORE_METHOD;
    }

    function renderPanels(analysis: ReturnType<typeof analyzeProcess>) {
      renderClassifications(analysis);
      renderCompleteness();
      renderGraphIssues(analysis);
      renderHandoffs(analysis);
      renderSilentFailures(analysis);
      renderApprovalPoints(analysis);
      renderActors(analysis);
      renderOrder(analysis);
    }

    // Full path: the editor cards and every read only panel, from a
    // fresh analysis. Used whenever the shape of the process might have
    // changed, add, remove, move, a dropdown or checkbox commit, load
    // sample, reset.
    function renderResults() {
      const analysis = analyzeProcess(state);
      const levels = new Map(
        Array.from(analysis.classifications.entries()).map(([id, c]) => [id, c.level as string]),
      );
      renderSteps(levels);
      renderPanels(analysis);
    }

    // Panels only, editor cards untouched. A text field edit changes no
    // structure, so the card the visitor is typing in, and its cursor
    // position, are left alone rather than rebuilt on every keystroke.
    function renderPanelsOnly() {
      renderPanels(analyzeProcess(state));
    }

    function render() {
      const mark = captureFocus();
      renderResults();
      restoreFocus(mark);
    }

    /* ---- State mutation -------------------------------------------- */
    function updateStepField(stepId: string, field: string, rawValue: string) {
      const step = state.steps.find((s) => s.id === stepId);
      if (!step) return;

      if (field === 'name' || field === 'owner' || field === 'completionEvidence') {
        step[field] = rawValue;
      } else if (
        field === 'inputStructured' ||
        field === 'outputVerifiable' ||
        field === 'reversible' ||
        field === 'needsJudgment' ||
        field === 'legalFinancialRisk'
      ) {
        step.properties[field] = rawValue === 'true';
      } else if (field === 'frequency') {
        step.properties.frequency = rawValue as StepProperties['frequency'];
      } else if (field === 'mistakeCost') {
        step.properties.mistakeCost = rawValue as StepProperties['mistakeCost'];
      }
      state.scenarioId = 'custom';
    }

    function updateDependsOn(stepId: string, otherId: string, checked: boolean) {
      const step = state.steps.find((s) => s.id === stepId);
      if (!step) return;
      if (checked) {
        if (!step.dependsOn.includes(otherId)) step.dependsOn.push(otherId);
      } else {
        step.dependsOn = step.dependsOn.filter((id) => id !== otherId);
      }
      state.scenarioId = 'custom';
    }

    function addStep() {
      const last = state.steps[state.steps.length - 1];
      const step: Step = {
        id: newStepId(),
        name: '',
        owner: '',
        completionEvidence: '',
        dependsOn: last ? [last.id] : [],
        properties: { ...DEFAULT_PROPERTIES },
      };
      state.steps.push(step);
      state.scenarioId = 'custom';
      render();
      const nameInput = root!.querySelector<HTMLInputElement>(
        `[data-step-card][data-step-id="${step.id}"] [data-step-field="name"]`,
      );
      nameInput?.focus();
    }

    function removeStep(stepId: string) {
      state.steps = state.steps.filter((s) => s.id !== stepId);
      // A step that depended on the removed one loses that dependency
      // rather than pointing at a ghost. It surfaces as an orphan if
      // nothing else connects it, which is the honest thing to show.
      for (const step of state.steps) {
        step.dependsOn = step.dependsOn.filter((id) => id !== stepId);
      }
      state.scenarioId = 'custom';
      render();
    }

    function moveStep(stepId: string, direction: -1 | 1) {
      const index = state.steps.findIndex((s) => s.id === stepId);
      const target = index + direction;
      if (index === -1 || target < 0 || target >= state.steps.length) return;
      const [step] = state.steps.splice(index, 1);
      state.steps.splice(target, 0, step);
      state.scenarioId = 'custom';
      render();
    }

    function loadSample(id: string) {
      state = sampleState(id);
      if (outcomeInput) outcomeInput.value = state.outcome;
      if (inputsInput) inputsInput.value = state.inputs;
      if (constraintsInput) constraintsInput.value = state.constraints;
      const teaches = el('[data-teaches]');
      if (teaches) teaches.textContent = getSample(id)?.teaches ?? '';
      render();
    }

    /* ---- Wiring ------------------------------------------------------ */
    root.addEventListener('input', (event) => {
      const target = event.target as HTMLElement;
      if (target.matches('#field-outcome')) {
        state.outcome = (target as HTMLInputElement).value;
        return;
      }
      if (target.matches('#field-inputs')) {
        state.inputs = (target as HTMLTextAreaElement).value;
        return;
      }
      if (target.matches('#field-constraints')) {
        state.constraints = (target as HTMLTextAreaElement).value;
        return;
      }
      const stepId = target.getAttribute('data-step-id');
      const field = target.getAttribute('data-step-field');
      if (!stepId || !field) return;
      const kind = target.getAttribute('data-step-kind');
      // Text and textarea fields update state quietly and only refresh
      // the read only results, so the field the visitor is typing in
      // never loses focus. Select and checkbox fields fire 'change',
      // not 'input', so this branch only ever sees free text.
      if (kind !== 'bool' && !(target instanceof HTMLSelectElement) && !(target instanceof HTMLInputElement && target.type === 'checkbox')) {
        updateStepField(stepId, field, (target as HTMLInputElement | HTMLTextAreaElement).value);
        renderPanelsOnly();
      }
    });

    root.addEventListener('change', (event) => {
      const target = event.target as HTMLElement;

      if (target instanceof HTMLInputElement && target.type === 'checkbox' && target.dataset.stepField === 'dependsOn') {
        const stepId = target.dataset.stepId;
        const otherId = target.dataset.dependsOnId;
        if (stepId && otherId) {
          updateDependsOn(stepId, otherId, target.checked);
          render();
        }
        return;
      }

      const stepId = target.getAttribute('data-step-id');
      const field = target.getAttribute('data-step-field');
      if (!stepId || !field) return;
      if (target instanceof HTMLSelectElement) {
        updateStepField(stepId, field, target.value);
        render();
      }
    });

    root.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const moveUp = target.closest<HTMLElement>('[data-move-up]');
      const moveDown = target.closest<HTMLElement>('[data-move-down]');
      const remove = target.closest<HTMLElement>('[data-remove-step]');
      if (moveUp) moveStep(moveUp.dataset.stepId!, -1);
      else if (moveDown) moveStep(moveDown.dataset.stepId!, 1);
      else if (remove) removeStep(remove.dataset.stepId!);
    });

    el('[data-add-step]')?.addEventListener('click', addStep);

    el('[data-load-sample]')?.addEventListener('click', () => {
      const id = el<HTMLSelectElement>('[data-sample-select]')?.value ?? SAMPLES[0].id;
      loadSample(id);
    });

    el('[data-reset]')?.addEventListener('click', () => {
      state = emptyState();
      if (outcomeInput) outcomeInput.value = '';
      if (inputsInput) inputsInput.value = '';
      if (constraintsInput) constraintsInput.value = '';
      const teaches = el('[data-teaches]');
      if (teaches) teaches.textContent = '';
      render();
    });

    root.addEventListener('workbench:load-sample', () => loadSample(SAMPLES[0].id));

    root.addEventListener('workbench:export', ((event: CustomEvent) => {
      const { format, resolve } = event.detail ?? {};
      if (typeof resolve !== 'function') return;
      const fmt = format === 'markdown' ? 'markdown' : 'json';
      resolve(serialize(state, fmt));
    }) as EventListener);

    // Explicit export for Agent Designer. This is a plain download, not
    // a live call into that tool: see buildAgentDesignerPayload in the
    // lib module, which never imports that other tool's own module and
    // is never imported by it either.
    el('[data-export-agent-handoff]')?.addEventListener('click', () => {
      const payload = buildAgentDesignerPayload(state);
      const text = JSON.stringify(payload, null, 2);
      const blob = new Blob([text], { type: 'application/json;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `${slugifyLocal(state.outcome)}-agent-handoff.json`;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);

      const status = el('[data-agent-export-status]');
      if (status) {
        status.textContent = 'Downloaded. Carry this file into Agent Designer by hand once it ships.';
        window.setTimeout(() => {
          if (status.textContent) status.textContent = '';
        }, 4000);
      }
    });

    render();
  }
</script>
