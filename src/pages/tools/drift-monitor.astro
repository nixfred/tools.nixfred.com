---
// Drift Monitor.
//
// tools-nixfred-prds/tools/12-DRIFT-MONITOR.md. Primary function is the
// structured snapshot differ the PRD actually specifies: two system
// snapshots in, a sorted list of findings out, each one citing the
// field path it changed, permission widenings called out ahead of
// everything else, intentional changes separated from unexplained
// drift, missing evaluation coverage listed, and an ordered rollback
// checklist. See src/lib/tools/drift-monitor.ts, section 13 onward,
// and its revision history note for why this page looks different
// from the first version shipped.
//
// The two proportion significance engine (that first version, sections
// 1 through 12 of the lib file) is preserved unmodified and demoted to
// a secondary panel here: it tests one of the seven snapshot inputs,
// evaluation results, rather than standing in for the whole tool.
//
// All arithmetic and diffing lives in the lib file. This file is the
// shell: it renders the form once from an empty template, renders a
// results skeleton whose numbers are filled in by client script, and
// wires the kit's event contract (workbench:load-sample,
// workbench:export). Nothing here computes a diff or a p value.
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getTool } from '../../data/registry';
import {
  Field,
  ResultPanel,
  AssumptionList,
  HelpNote,
  WarningNote,
  ExportBar,
  EmptyState,
} from '../../components/kit';
import {
  emptySnapshot,
  serializeSnapshot,
  ASSUMPTIONS_TEXT,
  VERDICT_LABELS,
  COMPARISON_SAMPLES,
} from '../../lib/tools/drift-monitor';

const tool = getTool('drift-monitor')!;

const ALPHA_OPTIONS = [
  { value: '0.1', label: '0.10 (90 percent confidence)' },
  { value: '0.05', label: '0.05 (95 percent confidence)' },
  { value: '0.01', label: '0.01 (99 percent confidence)' },
];
const POWER_OPTIONS = [
  { value: '0.8', label: '80 percent' },
  { value: '0.9', label: '90 percent' },
];
const EVAL_SET_OPTIONS = [
  { value: 'no', label: 'No, it is the same eval set' },
  { value: 'yes', label: 'Yes, it changed' },
];
const SAMPLE_OPTIONS = COMPARISON_SAMPLES.map((s) => ({ value: s.id, label: s.name }));

const initialBaselineText = serializeSnapshot(emptySnapshot('Baseline'));
const initialCurrentText = serializeSnapshot(emptySnapshot('Current'));

// Numeric assumption rows behind the significance panel. Order is load
// bearing: the client script updates row N by index, so this array
// and the script's writer must stay in the same order.
const RUN_PARAMETER_DEFAULTS = {
  alpha: 0.05,
  metricsMonitored: 1,
  targetPower: 0.8,
  minMeaningfulEffect: 0.05,
};
function runParameterItems(p: typeof RUN_PARAMETER_DEFAULTS) {
  return [
    { label: 'Significance level (alpha)', value: `${p.alpha}`, editable: false, source: 'the significance level field below' },
    { label: 'Confidence level used per rate', value: `${((1 - p.alpha) * 100).toFixed(0)} percent`, editable: false, source: '1 minus alpha' },
    { label: 'Metrics monitored together', value: `${p.metricsMonitored}`, editable: false, source: 'the metrics monitored field below' },
    { label: 'Bonferroni corrected alpha', value: `${(p.alpha / p.metricsMonitored).toFixed(4)}`, editable: false, source: 'alpha divided by metrics monitored' },
    { label: 'Target power for detectable effect', value: `${(p.targetPower * 100).toFixed(0)} percent`, editable: false, source: 'the target power field below' },
    { label: 'Smallest change said to matter', value: `${(p.minMeaningfulEffect * 100).toFixed(2)} points`, editable: false, source: 'the meaningful effect field below' },
  ];
}
---

<ToolLayout tool={tool}>
  <div class="monitor" data-monitor>
    <WarningNote severity="info" title="Two snapshots in, a structured diff out">
      <p>
        Paste or edit two system snapshots as JSON below, a baseline and a current one,
        each covering prompts, tools, permissions, knowledge sources, model settings,
        evaluation results, and any other metrics you track. Everything below is computed
        locally from exactly those two snapshots. This tool does not connect to any live
        system and does not monitor anything continuously; it compares two imports.
      </p>
    </WarningNote>

    <div id="monitor-empty-state">
      <EmptyState
        title="Paste two snapshots, or start from a worked example"
        body="Edit the baseline and current snapshot JSON below by hand, or load one of two worked examples: one where a permission widened quietly, one where every change is explained."
        sampleLabel="Load a worked example"
      />
    </div>

    <div id="monitor-app" data-monitor-app hidden>
      <section class="controls" aria-labelledby="scenario-heading">
        <h2 id="scenario-heading" class="eyebrow">Worked example</h2>
        <div class="controls-grid">
          <Field
            label="Example"
            name="sample"
            type="select"
            options={SAMPLE_OPTIONS}
            value={COMPARISON_SAMPLES[0].id}
            hint="Each example is a complete, schema valid snapshot pair, not a fragment."
          />
        </div>
        <div class="controls-actions">
          <button type="button" class="btn btn-primary" data-load-sample-btn>Load this example</button>
          <button type="button" class="btn" data-reset>Reset to empty</button>
        </div>
        <p class="teaches" data-teaches role="status" aria-live="polite"></p>
      </section>

      <div class="snapshots">
        <section class="snapshot" aria-labelledby="baseline-heading">
          <h2 id="baseline-heading" class="eyebrow">Baseline snapshot (JSON)</h2>
          <Field
            label="Baseline"
            name="baseline-json"
            type="textarea"
            value={initialBaselineText}
            rows={20}
            hint="Schema version, prompts, tools, permissions, knowledge sources, model settings, evaluation, metrics, changelog, evaluationCoverage."
          />
        </section>

        <section class="snapshot" aria-labelledby="current-heading">
          <h2 id="current-heading" class="eyebrow">Current snapshot (JSON)</h2>
          <Field
            label="Current"
            name="current-json"
            type="textarea"
            value={initialCurrentText}
            rows={20}
            hint="Its changelog entries are what mark a field path as an intentional change rather than unexplained drift."
          />
        </section>
      </div>

      <div id="monitor-results" data-monitor-results hidden>
        <div id="headline-callout" hidden>
          <WarningNote severity="alert" title="Permission expansion, review this first">
            <div data-headline-findings></div>
          </WarningNote>
        </div>

        <ResultPanel
          id="findings-panel"
          title="Findings"
          status="idle"
          description="Every difference between the two snapshots, permission widenings first, then sorted by risk. Each one cites the exact field path it changed."
        >
          <div data-findings></div>
        </ResultPanel>

        <ResultPanel
          id="coverage-panel"
          title="Missing evaluation coverage"
          status="idle"
          description="Changed surfaces the current snapshot's evaluationCoverage list does not declare as tested."
          headingLevel={2}
        >
          <ul class="coverage-list" data-coverage></ul>
        </ResultPanel>

        <ResultPanel
          id="rollback-panel"
          title="Rollback checklist"
          status="idle"
          description="Ordered to contain new access first, then correct configuration, then restore context. Capability reductions are listed last, since reverting those would mean granting access back."
          headingLevel={2}
        >
          <ol class="rollback-list" data-rollback></ol>
        </ResultPanel>

        <section class="significance-section" aria-labelledby="significance-heading">
          <h2 id="significance-heading" class="eyebrow">
            Evaluation results, the one input with a significance test behind it
          </h2>
          <p class="significance-lede">
            Everything above is a structural diff. This panel is the exception: it takes the
            <code>evaluation</code> field of each snapshot, a plain pass count, and runs the same
            rigorous two proportion significance engine regardless of what else changed.
          </p>

          <div class="field-grid">
            <Field
              label="Significance level"
              name="alpha"
              type="select"
              options={ALPHA_OPTIONS}
              value={String(RUN_PARAMETER_DEFAULTS.alpha)}
              hint="The chance of a false alarm this test accepts, before any multiple comparisons correction."
            />
            <Field
              label="Metrics monitored together"
              name="metrics-monitored"
              type="number"
              value={RUN_PARAMETER_DEFAULTS.metricsMonitored}
              min={1}
              step="1"
              hint="How many metrics are being watched in the same sweep. Drives the Bonferroni correction below."
            />
            <Field
              label="Target power"
              name="target-power"
              type="select"
              options={POWER_OPTIONS}
              value={String(RUN_PARAMETER_DEFAULTS.targetPower)}
              hint="The detection rate the minimum detectable effect below is calculated for."
            />
            <Field
              label="Smallest change that matters"
              name="min-meaningful-effect"
              type="number"
              value={RUN_PARAMETER_DEFAULTS.minMeaningfulEffect * 100}
              min={0.01}
              step="0.5"
              hint="In percentage points. A verdict of insufficient data means this comparison could not reliably detect a change this size."
            />
            <Field
              label="Did the evaluation set change?"
              name="eval-set-changed"
              type="select"
              options={EVAL_SET_OPTIONS}
              value="no"
              hint="If the test cases themselves are different, no statistic below can separate that from a real behavior change."
            />
          </div>

          <ResultPanel
            id="verdict-panel"
            title="Evaluation verdict"
            status="idle"
            description="The plain language answer, and the one number it is actually based on."
            headingLevel={3}
          >
            <p class="verdict-label" data-field="verdict-label" data-verdict="noise"></p>
            <p class="verdict-reason" data-field="verdict-reason"></p>
          </ResultPanel>

          <ResultPanel
            id="interval-panel"
            title="Confidence interval on the difference"
            status="idle"
            description="Current rate minus baseline rate. Whether this crosses zero is the actual answer to whether this is real."
            headingLevel={3}
          >
            <p class="diff-line mono" data-field="diff-line"></p>
            <div class="interval-bar" data-interval-bar>
              <div class="interval-track">
                <div class="interval-fill" data-interval-fill></div>
                <div class="interval-zero" data-interval-zero></div>
              </div>
              <div class="interval-scale">
                <span data-field="scale-min"></span>
                <span class="interval-scale-zero">0</span>
                <span data-field="scale-max"></span>
              </div>
            </div>
            <p class="interval-note" data-field="interval-note"></p>
          </ResultPanel>

          <ResultPanel
            id="rates-panel"
            title="Rates and Wilson intervals"
            status="idle"
            description="Wilson score intervals, not the normal approximation, so these stay inside 0 to 100 percent even at extreme rates."
            headingLevel={3}
          >
            <div class="result-table" role="table" aria-label="Rates and intervals">
              <div class="result-row result-head" role="row">
                <span role="columnheader">Snapshot</span>
                <span role="columnheader">Rate</span>
                <span role="columnheader">Wilson interval</span>
              </div>
              <div class="result-row" role="row">
                <span role="rowheader">Baseline</span>
                <span role="cell" class="mono" data-field="baseline-rate">0.00 percent</span>
                <span role="cell" class="mono" data-field="baseline-interval">0.00 to 0.00 percent</span>
              </div>
              <div class="result-row" role="row">
                <span role="rowheader">Current</span>
                <span role="cell" class="mono" data-field="current-rate">0.00 percent</span>
                <span role="cell" class="mono" data-field="current-interval">0.00 to 0.00 percent</span>
              </div>
            </div>
          </ResultPanel>

          <ResultPanel
            id="tests-panel"
            title="Significance tests"
            status="idle"
            description="Both a large sample test and a small sample exact test, because small samples are the common case in eval work."
            headingLevel={3}
          >
            <div class="result-table" role="table" aria-label="Significance tests">
              <div class="result-row result-head" role="row">
                <span role="columnheader">Test</span>
                <span role="columnheader">Statistic</span>
                <span role="columnheader">p value</span>
              </div>
              <div class="result-row" role="row">
                <span role="rowheader" data-field="z-row-label">Two proportion z test</span>
                <span role="cell" class="mono" data-field="z-statistic">z = 0.000</span>
                <span role="cell" class="mono" data-field="z-p">0.0000</span>
              </div>
              <div class="result-row" role="row">
                <span role="rowheader" data-field="fisher-row-label">Fisher exact test</span>
                <span role="cell" class="mono" data-field="fisher-statistic">exact</span>
                <span role="cell" class="mono" data-field="fisher-p">0.0000</span>
              </div>
            </div>
            <p class="which-test" data-field="which-test-reason"></p>
            <p class="bonferroni-line mono" data-field="bonferroni-line"></p>
          </ResultPanel>

          <ResultPanel
            id="power-panel"
            title="Statistical power"
            status="idle"
            description="What this comparison could have detected, independent of what it actually found."
            headingLevel={3}
          >
            <p class="mde-line mono" data-field="mde-line"></p>
            <p class="mde-note">
              This is the minimum detectable effect: the smallest true difference these exact
              sample sizes could catch at the target power above. It does not depend on what
              was actually observed. This tool deliberately does not report "observed power",
              the chance of detecting the effect that was actually seen, because that number is
              a fixed rescaling of the p value already shown above and is considered poor
              practice for exactly that reason.
            </p>
          </ResultPanel>

          <div id="monitor-warnings">
            <WarningNote severity="warning" title="Worth checking before you trust this verdict">
              <ul data-field="warnings-list"></ul>
            </WarningNote>
          </div>

          <AssumptionList
            name="run-parameters"
            title="Run parameters"
            items={runParameterItems(RUN_PARAMETER_DEFAULTS)}
          />

          <WarningNote severity="info" title="What the significance panel assumes">
            <ul class="assumptions-list">
              {ASSUMPTIONS_TEXT.map((a) => <li>{a}</li>)}
            </ul>
          </WarningNote>
        </section>
      </div>

      <HelpNote title="How this tool reads a snapshot pair">
        <p>
          Every difference between the two snapshots becomes a finding: a category (prompt,
          tool, permission, knowledge source, model setting, or metric), a direction (added,
          removed, modified, or for permissions specifically, widened or narrowed), a risk
          level, and the exact field path that changed. A permission widening, a grant that
          got strictly bigger than the baseline, always sorts first, regardless of what other
          risk levels are in play elsewhere in the comparison. Narrowing a permission is the
          opposite event and is treated as good news, not a risk.
        </p>
        <p>
          A change reads as intentional only when the current snapshot's own
          <code>changelog</code> cites that exact field path with a reason. Anything changed
          and not cited there is unexplained drift, which is the category that most needs a
          human to look at it. Checking the box on a finding below edits that changelog for
          you.
        </p>
        <p>
          Wilson score intervals for each rate, not the normal approximation, because normal
          breaks at extreme rates. The interval on the difference is built from those same two
          Wilson intervals by Newcombe's hybrid method. A two proportion z test and an exact
          Fisher test both run; the tool says which one to trust, using the standard rule that
          every expected cell in the comparison table should be at least 5 for the normal
          approximation to hold. Monitoring more than one metric at once widens the interval
          the verdict reads, by the Bonferroni correction, rather than leaving it to a
          footnote.
        </p>
      </HelpNote>

      <div class="actions">
        <ExportBar formats={['json', 'markdown']} filename="drift-monitor-comparison-report" />
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .monitor {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }

  .controls {
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-4);
  }

  .controls-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-3) var(--space-4);
  }

  .controls-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .teaches {
    color: var(--text-faint);
    font-size: var(--text-sm);
    margin: var(--space-2) 0 0;
    min-height: 1.5em;
  }

  .btn {
    font: 600 var(--text-xs) var(--font-sans);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .btn:hover {
    color: var(--accent);
    border-color: var(--signal-edge);
  }

  .btn-primary {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  .btn-primary:hover {
    background: var(--accent-strong);
    color: var(--bg);
  }

  .snapshots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-4);
  }

  .snapshot {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-3);
    background: var(--panel);
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-2) var(--space-4);
  }

  #monitor-results > :global(*) {
    margin-bottom: var(--space-4);
  }

  .significance-section {
    border-top: 1px solid var(--line);
    padding-top: var(--space-4);
    margin-top: var(--space-2);
  }

  .significance-lede {
    max-width: var(--measure);
    color: var(--text-faint);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-4);
  }

  .significance-lede code {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .significance-section .field-grid {
    margin-bottom: var(--space-4);
  }

  .coverage-list,
  .rollback-list {
    margin: 0;
    padding-left: 1.2rem;
    max-width: var(--measure);
  }

  .coverage-list li,
  .rollback-list li {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .coverage-list li:last-child,
  .rollback-list li:last-child {
    margin-bottom: 0;
  }

  .verdict-label {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: var(--track-tight);
    margin: 0 0 var(--space-2);
  }

  .verdict-reason {
    max-width: var(--measure);
    color: var(--text-muted);
    margin: 0;
  }

  .diff-line {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-3);
  }

  .interval-bar {
    margin-bottom: var(--space-2);
  }

  .interval-track {
    position: relative;
    height: 10px;
    background: var(--chassis-700);
    border-radius: var(--radius-pill);
    overflow: visible;
  }

  .interval-fill {
    position: absolute;
    top: 0;
    height: 100%;
    background: var(--accent-deep);
    border-radius: var(--radius-pill);
  }

  .interval-zero {
    position: absolute;
    top: -3px;
    width: 2px;
    height: 16px;
    background: var(--text-faint);
  }

  .interval-scale {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-dim);
    margin-top: var(--space-1);
  }

  .interval-scale-zero {
    color: var(--text-faint);
  }

  .interval-note {
    font-size: var(--text-sm);
    color: var(--text-faint);
    margin: 0;
  }

  .result-table {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: var(--space-3);
  }

  .result-row {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.4fr;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--line-faint);
  }

  .result-row:last-child {
    border-bottom: 0;
  }

  .result-head {
    background: var(--bg-alt);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .result-row span[role='rowheader'] {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .result-row span[role='cell'] {
    font-size: var(--text-sm);
  }

  .which-test {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
    max-width: var(--measure);
  }

  .bonferroni-line {
    font-size: var(--text-sm);
    color: var(--text-faint);
    margin: 0;
  }

  .mde-line {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2);
  }

  .mde-note {
    font-size: var(--text-sm);
    color: var(--text-faint);
    max-width: var(--measure);
    margin: 0;
  }

  .assumptions-list {
    margin: 0;
    padding-left: 1.2rem;
    max-width: var(--measure);
  }

  .assumptions-list li {
    margin-bottom: var(--space-2);
  }

  .assumptions-list li:last-child {
    margin-bottom: 0;
  }

  .actions {
    border-top: 1px solid var(--line);
    padding-top: var(--space-3);
  }

  @media (max-width: 34rem) {
    .result-row {
      grid-template-columns: 1fr 1fr;
    }

    .result-row span:nth-child(3) {
      grid-column: 1 / -1;
    }
  }
</style>

{/* Runtime injected markup is NOT reached by Astro scoped CSS (the
    Astro lesson, tokens leak otherwise, and so does everything else),
    so every class the script writes into or toggles is styled
    globally here. This covers the finding cards, the coverage and
    rollback list items rendered from plain strings, and the verdict
    color mapping. */}
<style is:global>
  .verdict-label[data-verdict='real-change'] {
    color: var(--status-alert);
  }

  .verdict-label[data-verdict='noise'] {
    color: var(--status-live);
  }

  .verdict-label[data-verdict='insufficient-data'] {
    color: var(--status-beta);
  }

  .verdict-label[data-verdict='invalid-comparison'] {
    color: var(--status-alert);
  }

  [data-field='warnings-list'] li {
    margin-bottom: var(--space-2);
  }

  [data-field='warnings-list'] li:last-child {
    margin-bottom: 0;
  }

  .finding {
    border: 1px solid var(--line);
    border-left-width: 3px;
    border-radius: var(--radius);
    padding: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .finding:last-child {
    margin-bottom: 0;
  }

  .finding[data-risk='critical'] {
    border-left-color: var(--status-alert);
  }

  .finding[data-risk='high'] {
    border-left-color: var(--status-alert);
  }

  .finding[data-risk='medium'] {
    border-left-color: var(--status-beta);
  }

  .finding[data-risk='low'],
  .finding[data-risk='info'] {
    border-left-color: var(--line-strong);
  }

  .finding-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .finding-risk,
  .finding-category,
  .finding-direction {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-faint);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.1rem 0.55rem;
  }

  .finding[data-risk='critical'] .finding-risk,
  .finding[data-risk='high'] .finding-risk {
    color: var(--status-alert);
    border-color: var(--status-alert);
  }

  .finding[data-risk='medium'] .finding-risk {
    color: var(--status-beta);
    border-color: var(--status-beta);
  }

  .finding[data-direction='widened'] .finding-direction {
    color: var(--status-alert);
    border-color: var(--status-alert);
  }

  .finding[data-direction='narrowed'] .finding-direction {
    color: var(--status-live);
    border-color: var(--status-live);
  }

  .finding-intentional {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-faint);
    margin-left: auto;
    cursor: pointer;
  }

  .finding-headline {
    font-size: var(--text-base);
    color: var(--text);
    margin: 0 0 var(--space-1);
    max-width: none;
  }

  .finding-effect {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
    max-width: none;
  }

  .finding-fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .finding-field {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .finding-path {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    overflow-wrap: anywhere;
  }

  .finding-before {
    color: var(--text-dim);
    text-decoration: line-through;
    overflow-wrap: anywhere;
  }

  .finding-arrow {
    color: var(--text-dim);
  }

  .finding-after {
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .finding-unexplained {
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--status-beta);
    margin: var(--space-2) 0 0;
  }

  .clean-note {
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  #headline-callout .finding {
    background: var(--panel-raised);
  }
</style>

<script>
  import type {
    DriftComparison,
    SystemSnapshot,
    ComparisonAnalysis,
    DriftFinding,
    EvalSetChanged,
  } from '../../lib/tools/drift-monitor';
  import {
    emptySnapshot,
    parseSnapshotJSON,
    serializeSnapshot,
    validateComparison,
    analyzeComparison,
    getComparisonSample,
    sampleComparison,
    serializeComparison,
    COMPARISON_SAMPLES,
    VERDICT_LABELS,
  } from '../../lib/tools/drift-monitor';

  const app = document.querySelector<HTMLElement>('[data-monitor-app]');
  const emptyStateEl = document.getElementById('monitor-empty-state');
  const resultsEl = document.querySelector<HTMLElement>('[data-monitor-results]');
  if (!app || !emptyStateEl || !resultsEl) throw new Error('drift monitor: shell markup is missing');

  /* ---- element lookups -------------------------------------------- */

  function field(id: string): HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement {
    const el = document.getElementById(id);
    if (!el) throw new Error(`drift monitor: missing field #${id}`);
    return el as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  }

  const sampleField = field('field-sample') as HTMLSelectElement;
  const baselineJsonField = field('field-baseline-json') as HTMLTextAreaElement;
  const currentJsonField = field('field-current-json') as HTMLTextAreaElement;
  const alphaField = field('field-alpha') as HTMLSelectElement;
  const metricsMonitoredField = field('field-metrics-monitored') as HTMLInputElement;
  const targetPowerField = field('field-target-power') as HTMLSelectElement;
  const minMeaningfulEffectField = field('field-min-meaningful-effect') as HTMLInputElement;
  const evalSetChangedField = field('field-eval-set-changed') as HTMLSelectElement;

  let interacted = false;

  /* ---- reading significance settings -------------------------------- */

  function readSignificanceSettings() {
    return {
      alpha: Number(alphaField.value) || 0.05,
      metricsMonitored: Number.isNaN(metricsMonitoredField.valueAsNumber)
        ? 1
        : metricsMonitoredField.valueAsNumber,
      targetPower: Number(targetPowerField.value) || 0.8,
      minMeaningfulEffect: Number.isNaN(minMeaningfulEffectField.valueAsNumber)
        ? 0.05
        : minMeaningfulEffectField.valueAsNumber / 100,
      evalSetChanged: (evalSetChangedField.value as EvalSetChanged) || 'no',
    };
  }

  /* ---- rendering helpers --------------------------------------------- */

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function setText(id: string, text: string) {
    const el = document.querySelector<HTMLElement>(`[data-field="${id}"]`);
    if (el) el.textContent = text;
  }

  function setPanelStatus(panelId: string, status: 'idle' | 'ready') {
    const panel = document.getElementById(panelId);
    if (panel) panel.dataset.resultStatus = status;
  }

  function pct(fraction: number): string {
    return `${(fraction * 100).toFixed(2)} percent`;
  }

  function signedPts(fraction: number): string {
    const value = fraction * 100;
    const sign = value >= 0 ? '+' : '';
    return `${sign}${value.toFixed(2)} points`;
  }

  function setFieldError(controlId: string, message: string | null) {
    const errorEl = document.getElementById(`${controlId}-error`);
    const control = document.getElementById(controlId);
    if (errorEl) {
      errorEl.hidden = !message;
      const text = errorEl.querySelector<HTMLElement>('[data-field-error-text]');
      if (text) text.textContent = message ?? '';
    }
    if (control) {
      if (message) control.setAttribute('aria-invalid', 'true');
      else control.removeAttribute('aria-invalid');
    }
  }

  /* ---- findings, coverage, rollback ----------------------------------- */

  function renderFindingCard(f: DriftFinding): string {
    const primaryPath = f.fields[0]?.path ?? f.id;
    const fieldsHtml = f.fields
      .map(
        (field) => `
      <div class="finding-field">
        <code class="finding-path">${esc(field.path)}</code>
        <span class="finding-before">${esc(field.before)}</span>
        <span class="finding-arrow">to</span>
        <span class="finding-after">${esc(field.after)}</span>
      </div>`,
      )
      .join('');
    return `
    <div class="finding" data-risk="${esc(f.risk)}" data-direction="${esc(f.direction)}">
      <div class="finding-head">
        <span class="finding-risk">${esc(f.risk)}</span>
        <span class="finding-category">${esc(f.category)}</span>
        <span class="finding-direction">${esc(f.direction)}</span>
        <label class="finding-intentional">
          <input type="checkbox" data-intentional-toggle data-path="${esc(primaryPath)}" ${f.intentional ? 'checked' : ''} />
          Intentional
        </label>
      </div>
      <p class="finding-headline">${esc(f.headline)}</p>
      <p class="finding-effect">${esc(f.likelyEffect)}</p>
      <div class="finding-fields">${fieldsHtml}</div>
      ${f.intentional ? '' : '<p class="finding-unexplained">Unexplained: no changelog entry covers this change.</p>'}
    </div>`;
  }

  function renderFindings(analysis: ComparisonAnalysis) {
    const container = document.querySelector<HTMLElement>('[data-findings]');
    const headlineWrap = document.getElementById('headline-callout');
    const headlineContainer = document.querySelector<HTMLElement>('[data-headline-findings]');
    if (container) {
      container.innerHTML = analysis.findings.length
        ? analysis.findings.map(renderFindingCard).join('')
        : '<p class="clean-note">No differences detected between the two snapshots.</p>';
    }
    if (headlineWrap && headlineContainer) {
      headlineWrap.hidden = analysis.headlineFindings.length === 0;
      headlineContainer.innerHTML = analysis.headlineFindings.map(renderFindingCard).join('');
    }
    setPanelStatus('findings-panel', 'ready');
  }

  function renderCoverage(analysis: ComparisonAnalysis) {
    const el = document.querySelector<HTMLElement>('[data-coverage]');
    if (!el) return;
    el.innerHTML = analysis.missingCoverage.length
      ? analysis.missingCoverage
          .map((m) => `<li><code class="finding-path">${esc(m.path)}</code>: ${esc(m.description)}</li>`)
          .join('')
      : '<li class="clean-note">Every changed surface is declared as covered by the current snapshot.</li>';
    setPanelStatus('coverage-panel', 'ready');
  }

  function renderRollback(analysis: ComparisonAnalysis) {
    const el = document.querySelector<HTMLElement>('[data-rollback]');
    if (!el) return;
    el.innerHTML = analysis.rollback.length
      ? analysis.rollback.map((r) => `<li>${esc(r.instruction)}</li>`).join('')
      : '<li class="clean-note">No configuration change requires a rollback step.</li>';
    setPanelStatus('rollback-panel', 'ready');
  }

  /* ---- significance panel, reads analysis.significance ---------------- */

  function renderIntervalBar(lower: number, upper: number) {
    const fill = document.querySelector<HTMLElement>('[data-interval-fill]');
    const zero = document.querySelector<HTMLElement>('[data-interval-zero]');
    if (!fill || !zero) return;
    const furthest = Math.max(Math.abs(lower), Math.abs(upper), 0.02);
    const domain = furthest * 1.3;
    const toPct = (value: number) => ((value + domain) / (2 * domain)) * 100;
    const leftPct = toPct(lower);
    const rightPct = toPct(upper);
    fill.style.left = `${leftPct}%`;
    fill.style.width = `${Math.max(0.5, rightPct - leftPct)}%`;
    zero.style.left = `${toPct(0)}%`;
    setText('scale-min', signedPts(-domain));
    setText('scale-max', signedPts(domain));
  }

  function renderSignificance(analysis: ComparisonAnalysis, settings: ReturnType<typeof readSignificanceSettings>) {
    const s = analysis.significance;

    const verdictLabelEl = document.querySelector<HTMLElement>('[data-field="verdict-label"]');
    if (verdictLabelEl) {
      verdictLabelEl.textContent = VERDICT_LABELS[s.verdict];
      verdictLabelEl.dataset.verdict = s.verdict;
    }
    setText('verdict-reason', s.verdictReason);
    setPanelStatus('verdict-panel', 'ready');

    setText('diff-line', `${signedPts(s.differenceInterval.diff)} (current minus baseline)`);
    renderIntervalBar(s.differenceInterval.lower, s.differenceInterval.upper);
    const crosses = s.differenceInterval.lower <= 0 && s.differenceInterval.upper >= 0;
    setText(
      'interval-note',
      `${(s.adjustedConfidence * 100).toFixed(2)} percent interval: ${signedPts(s.differenceInterval.lower)} to ${signedPts(s.differenceInterval.upper)}. ${
        crosses
          ? 'This interval includes zero, so a true difference of exactly zero cannot be ruled out.'
          : 'This interval excludes zero.'
      }`,
    );
    setPanelStatus('interval-panel', 'ready');

    setText('baseline-rate', pct(s.baselineRate));
    setText('baseline-interval', `${pct(s.baselineInterval.lower)} to ${pct(s.baselineInterval.upper)}`);
    setText('current-rate', pct(s.currentRate));
    setText('current-interval', `${pct(s.currentInterval.lower)} to ${pct(s.currentInterval.upper)}`);
    setPanelStatus('rates-panel', 'ready');

    setText('z-row-label', `Two proportion z test${s.primary.primaryTest === 'z' ? ' (primary)' : ''}`);
    setText('z-statistic', `z = ${s.zTest.z.toFixed(4)}`);
    setText('z-p', s.zTest.pValue.toFixed(4));
    setText('fisher-row-label', `Fisher exact test${s.primary.primaryTest === 'fisher' ? ' (primary)' : ''}`);
    if (s.fisher.computed) {
      setText('fisher-statistic', 'exact, hypergeometric');
      setText('fisher-p', s.fisher.pValue.toFixed(4));
    } else {
      setText('fisher-statistic', 'skipped');
      setText('fisher-p', s.fisher.note);
    }
    setText('which-test-reason', s.primary.reason);
    setText(
      'bonferroni-line',
      `Bonferroni corrected p value for the primary test: ${s.adjustedPValue.toFixed(4)} (raw ${s.primaryPValue.toFixed(4)}, ${settings.metricsMonitored} metric${settings.metricsMonitored === 1 ? '' : 's'} monitored).`,
    );
    setPanelStatus('tests-panel', 'ready');

    setText('mde-line', `Minimum detectable effect at these sample sizes: ${(s.minimumDetectableEffect * 100).toFixed(2)} points`);
    setPanelStatus('power-panel', 'ready');

    const warningsBlock = document.getElementById('monitor-warnings');
    const warningsList = document.querySelector<HTMLElement>('[data-field="warnings-list"]');
    if (warningsBlock && warningsList) {
      warningsBlock.hidden = s.warnings.length === 0;
      warningsList.innerHTML = s.warnings.map((w) => `<li>${esc(w)}</li>`).join('');
    }

    updateAssumptionRow(0, `${settings.alpha}`);
    updateAssumptionRow(1, `${((1 - settings.alpha) * 100).toFixed(0)} percent`);
    updateAssumptionRow(2, `${settings.metricsMonitored}`);
    updateAssumptionRow(3, `${s.adjustedAlpha.toFixed(4)}`);
    updateAssumptionRow(4, `${(settings.targetPower * 100).toFixed(0)} percent`);
    updateAssumptionRow(5, `${(settings.minMeaningfulEffect * 100).toFixed(2)} points`);
  }

  function updateAssumptionRow(index: number, value: string) {
    const row = document.querySelector<HTMLElement>(
      `[data-list-name="run-parameters"] .assumption-row[data-index="${index}"] [data-assumption-value]`,
    );
    if (row) row.textContent = value;
  }

  /* ---- the recompute cycle -------------------------------------------- */

  function currentComparison(): { comparison: DriftComparison | null; baselineError: string | null; currentError: string | null } {
    const baselineParsed = parseSnapshotJSON(baselineJsonField.value);
    const currentParsed = parseSnapshotJSON(currentJsonField.value);
    if (!baselineParsed.ok || !currentParsed.ok) {
      return {
        comparison: null,
        baselineError: baselineParsed.ok ? null : baselineParsed.error,
        currentError: currentParsed.ok ? null : currentParsed.error,
      };
    }
    return {
      comparison: { baseline: baselineParsed.snapshot, current: currentParsed.snapshot, ...readSignificanceSettings() },
      baselineError: null,
      currentError: null,
    };
  }

  function recompute() {
    if (interacted) {
      app!.hidden = false;
      emptyStateEl!.hidden = true;
    }

    const { comparison, baselineError, currentError } = currentComparison();
    setFieldError('field-baseline-json', baselineError);
    setFieldError('field-current-json', currentError);

    if (!comparison) {
      resultsEl.hidden = true;
      return;
    }

    const issues = validateComparison(comparison).filter(
      (i) => !i.field.startsWith('baseline.') && !i.field.startsWith('current.'),
    );
    const fieldToControlId: Record<string, string> = {
      alpha: 'field-alpha',
      metricsMonitored: 'field-metrics-monitored',
      targetPower: 'field-target-power',
      minMeaningfulEffect: 'field-min-meaningful-effect',
      evalSetChanged: 'field-eval-set-changed',
    };
    for (const controlId of Object.values(fieldToControlId)) setFieldError(controlId, null);
    for (const issue of issues) {
      const controlId = fieldToControlId[issue.field];
      if (controlId) setFieldError(controlId, issue.message);
    }

    resultsEl.hidden = false;
    const analysis = analyzeComparison(comparison);
    renderFindings(analysis);
    renderCoverage(analysis);
    renderRollback(analysis);
    renderSignificance(analysis, readSignificanceSettings());
  }

  /* ---- wiring ----------------------------------------------------------- */

  [
    baselineJsonField, currentJsonField, alphaField, metricsMonitoredField,
    targetPowerField, minMeaningfulEffectField, evalSetChangedField,
  ].forEach((el) => {
    el.addEventListener('input', () => {
      interacted = true;
      recompute();
    });
    el.addEventListener('change', () => {
      interacted = true;
      recompute();
    });
  });

  function loadSample(id: string) {
    interacted = true;
    const sample = getComparisonSample(id) ?? COMPARISON_SAMPLES[0];
    baselineJsonField.value = serializeSnapshot(sample.comparison.baseline);
    currentJsonField.value = serializeSnapshot(sample.comparison.current);
    alphaField.value = String(sample.comparison.alpha);
    metricsMonitoredField.value = String(sample.comparison.metricsMonitored);
    targetPowerField.value = String(sample.comparison.targetPower);
    minMeaningfulEffectField.value = String(sample.comparison.minMeaningfulEffect * 100);
    evalSetChangedField.value = sample.comparison.evalSetChanged;
    const teaches = document.querySelector<HTMLElement>('[data-teaches]');
    if (teaches) teaches.textContent = sample.teaches;
    recompute();
  }

  document.querySelector('[data-load-sample-btn]')?.addEventListener('click', () => {
    loadSample(sampleField.value);
  });

  emptyStateEl.addEventListener('workbench:load-sample', () => {
    loadSample(COMPARISON_SAMPLES[0].id);
  });

  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    interacted = true;
    baselineJsonField.value = serializeSnapshot(emptySnapshot('Baseline'));
    currentJsonField.value = serializeSnapshot(emptySnapshot('Current'));
    alphaField.value = '0.05';
    metricsMonitoredField.value = '1';
    targetPowerField.value = '0.8';
    minMeaningfulEffectField.value = '5';
    evalSetChangedField.value = 'no';
    const teaches = document.querySelector<HTMLElement>('[data-teaches]');
    if (teaches) teaches.textContent = '';
    recompute();
  });

  // Toggling a finding's checkbox edits the CURRENT snapshot's own
  // changelog, live, which is what the tool module contract calls
  // "a flag in the snapshot": the mark travels with the export.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const checkbox = target.closest<HTMLInputElement>('[data-intentional-toggle]');
    if (!checkbox) return;
    const path = checkbox.dataset.path;
    if (!path) return;
    const parsed = parseSnapshotJSON(currentJsonField.value);
    if (!parsed.ok) return;
    const snapshot: SystemSnapshot = parsed.snapshot;
    const existingIndex = snapshot.changelog.findIndex((entry) => entry.path === path);
    if (existingIndex >= 0) {
      snapshot.changelog.splice(existingIndex, 1);
    } else {
      snapshot.changelog.push({ path, note: 'Marked intentional by reviewer.' });
    }
    currentJsonField.value = serializeSnapshot(snapshot);
    recompute();
  });

  app.addEventListener('workbench:export', ((event: CustomEvent) => {
    const { format, resolve } = event.detail ?? {};
    if (typeof resolve !== 'function') return;
    const { comparison } = currentComparison();
    if (!comparison) {
      resolve(null);
      return;
    }
    try {
      const fmt = format === 'markdown' ? 'markdown' : 'json';
      resolve(serializeComparison(comparison, fmt));
    } catch {
      resolve(null);
    }
  }) as EventListener);

  // Initial paint matches the server rendered empty template: both
  // snapshots have n=0 and fail validation, so results stay hidden.
  recompute();
</script>
