    margin-top: var(--space-2);
  }

  .property-row {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
    background: var(--bg-alt);
  }

  .property-fields {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .property-fields input[type='text'] {
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.3rem 0.5rem;
    font-size: var(--text-sm);
  }

  .property-description-input {
    flex: 2 1 240px;
  }

  .property-concern-input {
    flex: 1 1 140px;
  }

  .property-fields label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-faint);
    white-space: nowrap;
  }

  .property-fields input[type='number'],
  .property-fields select {
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.25rem 0.4rem;
    font: inherit;
    font-size: var(--text-sm);
  }

  .property-remove {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--status-alert);
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.2rem 0.5rem;
    cursor: pointer;
  }

  .check-config {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    padding-top: var(--space-2);
    border-top: 1px solid var(--line-faint);
  }

  .check-config label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .check-config input[type='text'],
  .check-config input[type='number'] {
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.25rem 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .check-hint {
    font-size: var(--text-xs);
    color: var(--text-dim);
    margin: 0;
  }

  .btn-mini {
    font: 600 var(--text-xs) var(--font-sans);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
  }

  .btn-mini:hover {
    border-color: var(--signal-edge);
  }

  /* Candidate output blocks inside a case card */
  .candidate-output-block {
    border: 1px solid var(--line-faint);
    border-radius: var(--radius);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .candidate-output-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 var(--space-1);
  }

  .candidate-output-block textarea {
    display: block;
    width: 100%;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }

  .property-score-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-1) 0;
    border-bottom: 1px solid var(--line-faint);
    font-size: var(--text-sm);
  }

  .property-score-row:last-child {
    border-bottom: 0;
  }

  .property-score-desc {
    color: var(--text-muted);
    flex: 1 1 auto;
  }

  .property-score-row select,
  .property-score-row input[type='number'] {
    background: var(--bg-alt);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.2rem 0.4rem;
    font: inherit;
  }

  .check-status-badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    color: var(--text-faint);
    white-space: normal;
    max-width: 26rem;
  }

  .check-status-badge[data-status='pass'] {
    color: var(--status-live);
    border-color: var(--status-live);
  }

  .check-status-badge[data-status='fail'] {
    color: var(--status-alert);
    border-color: var(--status-alert);
  }

  .check-status-badge[data-status='error'] {
    color: var(--status-beta);
    border-color: var(--status-beta);
  }

  /* Results panel */
  .candidate-result-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .candidate-result-card:last-child {
    margin-bottom: 0;
  }

  .result-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0 0 var(--space-2);
  }

  .verdict-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--line);
