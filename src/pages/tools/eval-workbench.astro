---
// Evaluation Workbench.
// PRD: tools-nixfred-prds/tools/06-EVAL-WORKBENCH.md
//
// A working scoring workbench. Cases are the primary object, each with
// an input, one or more expected properties, and a critical flag. Two
// or more candidates supply outputs for those cases. Each property is
// checked either by hand, pass or fail or on a scale of 1 to 5, or by
// a deterministic local check: exact match, contains, a regular
// expression, JSON object validity, or a length bound.
//
// Nothing here runs or simulates a model. A deterministic check is a
// plain comparison against text the user already pasted in, and a
// manual score is typed in from a run the user already made. The
// heart of the tool is the critical case rule: an aggregate score can
// never hide a failed critical case, which the results panel makes
// visually unmissable rather than folding into an average.
import ToolLayout from '../../layouts/ToolLayout.astro';
import Field from '../../components/kit/Field.astro';
import ResultPanel from '../../components/kit/ResultPanel.astro';
import HelpNote from '../../components/kit/HelpNote.astro';
import WarningNote from '../../components/kit/WarningNote.astro';
import ExportBar from '../../components/kit/ExportBar.astro';
import EmptyState from '../../components/kit/EmptyState.astro';
import { getTool } from '../../data/registry';
import {
  SCORE_MODES,
  SCORE_MODE_LABELS,
  CONFIDENCE_LEVELS,
  POWER_LEVELS,
  SAMPLES,
  emptyState,
} from '../../lib/tools/eval-workbench';

const tool = getTool('eval-workbench')!;
const defaultState = emptyState();

const scoreModeOptions = SCORE_MODES.map((m) => ({ value: m, label: SCORE_MODE_LABELS[m] }));
const confidenceOptions = CONFIDENCE_LEVELS.map((c) => ({ value: String(c), label: `${c} percent` }));
const powerOptions = POWER_LEVELS.map((p) => ({ value: String(p), label: `${p} percent` }));
---

<ToolLayout tool={tool}>
  <div class="workbench" data-workbench>
    <div class="toolbar">
      <div class="toolbar-group">
        <label class="label" for="sample">Sample scenario</label>
        <select id="sample" data-sample-select>
          {SAMPLES.map((s) => <option value={s.id}>{s.name}</option>)}
        </select>
        <button type="button" class="btn btn-primary" data-load-sample>
          Load sample
        </button>
      </div>
      <div class="toolbar-group">
        <button type="button" class="btn" data-reset>Reset</button>
      </div>
    </div>

    <p class="teaches" data-teaches role="status" aria-live="polite"></p>

    <ResultPanel
      title="Evaluation set"
      id="set-panel"
      headingLevel={2}
      description="Name what this set is for, and which concerns it should cover."
    >
      <Field label="Name" name="name" type="text" placeholder="What is this evaluation set called" />
      <Field
        label="Description"
        name="description"
        type="textarea"
        rows={2}
        placeholder="What failure or decision this evaluation set is for"
      />
      <Field
        label="Concerns, separated by commas"
        name="concerns"
        type="text"
        placeholder="Format validity, Tone, Credential safety"
        hint="Declared up front. The coverage report below checks whether any case actually exercises each one."
      />
    </ResultPanel>

    <ResultPanel
      title="Rubric and thresholds"
      id="rubric-panel"
      headingLevel={2}
      description="Both rubrics are fully supported. A deterministic check always resolves to pass or fail regardless of which rubric is in force."
    >
      <div class="stats-grid">
        <Field label="Scoring rubric" name="scoreMode" type="select" options={scoreModeOptions} value={defaultState.scoreMode} />
        <Field
          label="Pass threshold"
          name="passThreshold"
          type="number"
          min={0.01}
          max={1}
          step={0.01}
          value={defaultState.passThreshold}
          hint="Fraction of fully scored cases a candidate must pass, on top of the critical case rule."
        />
        <Field label="Confidence level" name="confidenceLevel" type="select" options={confidenceOptions} value={String(defaultState.confidenceLevel)} />
        <Field label="Statistical power" name="power" type="select" options={powerOptions} value={String(defaultState.power)} />
      </div>
    </ResultPanel>

    <ResultPanel
      title="Candidates"
      id="candidates-panel"
      headingLevel={2}
      description="Two or more configurations to compare. Paste each one's output per case below."
    >
      <div data-candidates-list></div>
      <button type="button" class="btn" data-candidate-add>Add candidate</button>
    </ResultPanel>

    <ResultPanel
      title="Cases"
      id="cases-panel"
      headingLevel={2}
      description="Cases are the primary object. Each has an input, one or more expected properties, and a critical flag."
    >
      <div data-cases-list></div>
      <button type="button" class="btn btn-primary" data-case-add>Add case</button>
    </ResultPanel>

    <div data-empty-wrapper>
      <EmptyState
        title="No cases yet"
        body="Add a case above, or load the sample to see a complete scored evaluation set end to end."
        sampleLabel="Load a sample"
      />
    </div>

    <div class="gated" data-gated hidden>
      <ResultPanel
        title="Candidate results"
        id="results-panel"
        headingLevel={2}
        description="Computed only from the checks and scores entered above. A critical case failure overrides the pass rate."
      >
        <div data-results-output></div>
      </ResultPanel>

      <ResultPanel
        title="Coverage gaps"
        id="coverage-panel"
        headingLevel={2}
        description="Declared concerns no case actually exercises, cases that check nothing, and whether there are enough candidates to compare."
      >
        <div data-coverage-output></div>
      </ResultPanel>

      <ResultPanel
        title="Disagreement"
        id="disagreement-panel"
        headingLevel={2}
        description="Where candidates diverge most on the same case, and where the same concern scored inconsistently for one candidate."
      >
        <div data-disagreement-output></div>
      </ResultPanel>

      <ResultPanel
        title="Detectable regression"
        id="mde-panel"
        headingLevel={2}
        description="Given the number of cases in this set, the smallest true regression this eval could catch. A secondary, honest estimate, not the product."
      >
        <div data-mde-output></div>
      </ResultPanel>

      <div class="import-row">
        <Field
          label="Import an evaluation set"
          name="importText"
          type="textarea"
          rows={3}
          placeholder="Paste a previously exported evaluation set here."
          hint="Accepts the JSON this tool exports."
        />
        <button type="button" class="btn" data-import>Import</button>
        <span class="import-status mono" data-import-status role="status" aria-live="polite"></span>
      </div>

      <ExportBar formats={['json', 'markdown']} filename="eval-workbench-set" />

      <HelpNote title="Why can a high average still be a failing eval">
        <p>
          An average is a summary, and a summary is exactly what a
          serious failure can hide inside. A candidate that gets nine
          of ten cases right looks like a strong candidate right up
          until the tenth case is the one where it leaks a credential
          or approves a transaction it should have refused. Averaging
          that case in with the rest treats a rare, severe failure the
          same as an ordinary miss.
        </p>
        <p>
          Marking a case critical says plainly that it is not the same
          as the rest. This tool checks every critical case on its own
          terms, pass or fail, with no partial credit and no averaging.
          If one fails, the candidate fails, and the pass rate above is
          shown next to that result rather than in place of it.
        </p>
      </HelpNote>
    </div>
  </div>
</ToolLayout>

<style>
  .workbench {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-3);
  }

  .toolbar-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  select {
    background: var(--panel);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    font: inherit;
  }

  .btn {
    font: 600 var(--text-xs) var(--font-sans);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }

  .btn:hover {
    color: var(--accent);
    border-color: var(--signal-edge);
  }

  .btn-primary {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
    margin-top: var(--space-2);
  }

  .btn-primary:hover {
    background: var(--accent-strong);
    color: var(--bg);
  }

  .teaches {
    color: var(--text-faint);
    font-size: var(--text-sm);
    margin: 0;
    min-height: 1.5em;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3) var(--space-4);
  }

  .gated {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .import-row {
    border-top: 1px solid var(--line);
    padding-top: var(--space-3);
  }

  .import-status {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-faint);
  }
</style>

{/* Runtime injected markup is NOT reached by Astro scoped CSS, so every
    class the script creates is styled with :global here. */}
<style is:global>
