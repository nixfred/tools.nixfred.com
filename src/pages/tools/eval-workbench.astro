  }

  .verdict-badge[data-verdict='fail'] {
    color: var(--status-alert);
    border-color: var(--status-alert);
  }

  .verdict-badge[data-verdict='incomplete'],
  .verdict-badge[data-verdict='not-scored'] {
    color: var(--status-beta);
    border-color: var(--status-beta);
  }

  .verdict-badge[data-verdict='no-cases'] {
    color: var(--text-dim);
    border-color: var(--line);
  }

  .stats-row {
    display: grid;
    grid-template-columns: minmax(160px, 1fr) 2fr;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line-faint);
  }

  .stats-row:last-child {
    border-bottom: 0;
  }

  .stats-label {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .stats-value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
    color: var(--text);
  }

  .stats-method {
    display: block;
    font-size: var(--text-xs);
    color: var(--text-dim);
    margin-top: var(--space-1);
  }

  .critical-alert {
    font-size: var(--text-sm);
    color: var(--status-alert);
    margin: var(--space-2) 0 0;
  }

  .coverage-gaps {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
    padding-left: 1.1rem;
  }

  .divergence-row {
    margin-bottom: var(--space-2);
  }

  .divergence-case {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }

  .divergence-detail {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
  }
</style>

<script>
  import {
    CHECK_TYPES,
    CHECK_TYPE_LABELS,
    runCheck,
    outputKey,
    scoreKey,
    newCase,
    newProperty,
    newCandidate,
    withCaseAdded,
    withCaseUpdated,
    withCaseRemoved,
    withPropertyAdded,
    withPropertyUpdated,
    withPropertyRemoved,
    withCandidateAdded,
    withCandidateUpdated,
    withCandidateRemoved,
    withOutputSet,
    withManualScoreSet,
    computeAllAggregates,
    computeCoverageGaps,
    computeCaseDivergence,
    computeRubricInconsistencies,
    evalSetMde,
    emptyState,
    sampleState,
    reset,
    serialize,
    importState,
    getSample,
    SAMPLES,
    type EvalPlanState,
    type EvalCase,
    type ExpectedProperty,
    type Candidate,
    type ScoreMode,
    type ConfidenceLevel,
    type PowerLevel,
    type CheckType,
  } from '../../lib/tools/eval-workbench';

  const root = document.querySelector<HTMLElement>('[data-workbench]');
  if (root) {
    const el = <T extends Element>(sel: string) => root.querySelector<T>(sel);
    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    let state: EvalPlanState = emptyState();

    const VERDICT_TEXT: Record<string, string> = {
      pass: 'Pass',
      fail: 'Fail',
      incomplete: 'Incomplete, not all cases scored',
      'not-scored': 'Not scored yet',
      'no-cases': 'No cases yet',
    };

    /* ---------------------------------------------------------------
     * Scalar field sync
     * ------------------------------------------------------------- */

    function readScalarsFromDom() {
      state.name = root.querySelector<HTMLInputElement>('[name="name"]')?.value ?? '';
      state.description = root.querySelector<HTMLTextAreaElement>('[name="description"]')?.value ?? '';
      const concernsRaw = root.querySelector<HTMLInputElement>('[name="concerns"]')?.value ?? '';
      state.concerns = concernsRaw
        .split(',')
        .map((s) => s.trim())
        .filter(Boolean);
      state.scoreMode =
        (root.querySelector<HTMLSelectElement>('[name="scoreMode"]')?.value as ScoreMode) ?? state.scoreMode;
      state.passThreshold = Number(root.querySelector<HTMLInputElement>('[name="passThreshold"]')?.value) || 0;
      state.confidenceLevel = Number(
        root.querySelector<HTMLSelectElement>('[name="confidenceLevel"]')?.value,
      ) as ConfidenceLevel;
      state.power = Number(root.querySelector<HTMLSelectElement>('[name="power"]')?.value) as PowerLevel;
    }

    function writeScalarsToDom() {
      const setVal = (name: string, value: string) => {
        const field = root.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          `[name="${name}"]`,
        );
        if (field) field.value = value;
      };
      setVal('name', state.name);
      setVal('description', state.description);
      setVal('concerns', state.concerns.join(', '));
      setVal('scoreMode', state.scoreMode);
      setVal('passThreshold', String(state.passThreshold));
      setVal('confidenceLevel', String(state.confidenceLevel));
      setVal('power', String(state.power));
    }

    /* ---------------------------------------------------------------
     * Rendering
     * ------------------------------------------------------------- */

    function checkConfigHtml(evalCase: EvalCase, property: ExpectedProperty): string {
      const c = property.check;
      const attrs = `data-case-id="${esc(evalCase.id)}" data-property-id="${esc(property.id)}"`;
      switch (property.checkType) {
        case 'manual':
          return '<p class="check-hint">Scored by hand for each candidate below.</p>';
        case 'exact-match':
        case 'contains':
          return `
            <label>Value <input type="text" data-check-value ${attrs} value="${esc(c.value)}" /></label>
            <label><input type="checkbox" data-check-casesensitive ${attrs} ${c.caseSensitive ? 'checked' : ''} /> Case sensitive</label>
            <label><input type="checkbox" data-check-negate ${attrs} ${c.negate ? 'checked' : ''} /> ${property.checkType === 'exact-match' ? 'Must not equal' : 'Must not contain'}</label>
          `;
        case 'regex':
          return `
            <label>Pattern <input type="text" data-check-value ${attrs} value="${esc(c.value)}" /></label>
            <label>Flags <input type="text" data-check-flags ${attrs} value="${esc(c.flags)}" /></label>
            <label><input type="checkbox" data-check-negate ${attrs} ${c.negate ? 'checked' : ''} /> Must not match</label>
          `;
        case 'json-schema':
          return `<label>Required keys, separated by commas <input type="text" data-check-requiredkeys ${attrs} value="${esc(c.requiredKeys.join(', '))}" /></label>`;
        case 'length-bounds':
          return `
            <label>Minimum length <input type="number" min="0" data-check-minlength ${attrs} value="${c.minLength ?? ''}" /></label>
            <label>Maximum length <input type="number" min="0" data-check-maxlength ${attrs} value="${c.maxLength ?? ''}" /></label>
          `;
        default:
          return '';
      }
    }

    function propertyRowHtml(evalCase: EvalCase, property: ExpectedProperty): string {
      const attrs = `data-case-id="${esc(evalCase.id)}" data-property-id="${esc(property.id)}"`;
      return `
        <div class="property-row" data-property-row ${attrs}>
          <div class="property-fields">
            <input type="text" class="property-description-input" data-property-description ${attrs}
              value="${esc(property.description)}" placeholder="What must be true" aria-label="Expected property description" />
            <input type="text" class="property-concern-input" data-property-concern ${attrs}
              value="${esc(property.concern)}" placeholder="Concern" aria-label="Concern tag" />
            <label>Weight
              <input type="number" min="1" max="5" step="1" data-property-weight ${attrs} value="${property.weight}" />
            </label>
            <select data-property-checktype ${attrs}>
              ${CHECK_TYPES.map(
                (t: CheckType) =>
                  `<option value="${t}" ${t === property.checkType ? 'selected' : ''}>${esc(CHECK_TYPE_LABELS[t])}</option>`,
              ).join('')}
            </select>
            <button type="button" class="property-remove" data-property-remove ${attrs}>Remove</button>
          </div>
          <div class="check-config" data-check-config>
            ${checkConfigHtml(evalCase, property)}
          </div>
        </div>
      `;
    }

    function propertyScoreRowHtml(evalCase: EvalCase, candidate: Candidate, property: ExpectedProperty): string {
      const desc = property.description || '(no description yet)';
      const attrs = `data-case-id="${esc(evalCase.id)}" data-candidate-id="${esc(candidate.id)}" data-property-id="${esc(property.id)}"`;

      if (property.checkType === 'manual') {
        const result = state.manualScores[scoreKey(candidate.id, evalCase.id, property.id)];
        const control =
          state.scoreMode === 'pass-fail'
            ? `<select data-manual-passfail ${attrs}>
                <option value="" ${!result?.passFail ? 'selected' : ''}>Not scored</option>
                <option value="pass" ${result?.passFail === 'pass' ? 'selected' : ''}>Pass</option>
                <option value="fail" ${result?.passFail === 'fail' ? 'selected' : ''}>Fail</option>
              </select>`
            : `<input type="number" min="1" max="5" step="1" placeholder="1 to 5" data-manual-scale ${attrs}
                value="${result?.scale ?? ''}" />`;
        return `<div class="property-score-row"><span class="property-score-desc">${esc(desc)}</span>${control}</div>`;
      }

      const outputText = state.outputs[outputKey(candidate.id, evalCase.id)] ?? '';
      const result = runCheck(property, outputText);
      return `
        <div class="property-score-row">
          <span class="property-score-desc">${esc(desc)}</span>
          <span class="check-status-badge" data-check-status ${attrs} data-status="${result.status}">
            ${esc(CHECK_TYPE_LABELS[property.checkType])}, ${esc(result.status)}. ${esc(result.detail)}
          </span>
        </div>
      `;
    }

    function candidateOutputBlockHtml(evalCase: EvalCase, candidate: Candidate): string {
      const outputText = state.outputs[outputKey(candidate.id, evalCase.id)] ?? '';
      return `
        <div class="candidate-output-block">
          <p class="candidate-output-label" data-candidate-output-label data-candidate-id="${esc(candidate.id)}">${esc(candidate.label)}</p>
          <textarea rows="3" data-output data-case-id="${esc(evalCase.id)}" data-candidate-id="${esc(candidate.id)}"
            placeholder="Paste this candidate's output for this case">${esc(outputText)}</textarea>
          <div class="property-scores">
            ${evalCase.expectedProperties.map((p) => propertyScoreRowHtml(evalCase, candidate, p)).join('')}
          </div>
        </div>
      `;
    }

    function caseCardHtml(evalCase: EvalCase): string {
      return `
        <div class="case-card" data-case-card data-case-id="${esc(evalCase.id)}" data-critical="${evalCase.critical}">
          <div class="case-head">
            <input type="text" class="case-title-input" data-case-title data-case-id="${esc(evalCase.id)}"
              value="${esc(evalCase.title)}" aria-label="Case title" />
            <label class="case-critical-toggle">
              <input type="checkbox" data-case-critical data-case-id="${esc(evalCase.id)}" ${evalCase.critical ? 'checked' : ''} />
              Critical
            </label>
            <button type="button" class="case-remove" data-case-remove data-case-id="${esc(evalCase.id)}">Remove case</button>
          </div>
          <label class="case-field-label">Input
            <textarea rows="2" data-case-input data-case-id="${esc(evalCase.id)}">${esc(evalCase.input)}</textarea>
          </label>

          <div class="properties-block">
            <p class="block-label">Expected properties</p>
            ${evalCase.expectedProperties.map((p) => propertyRowHtml(evalCase, p)).join('')}
            <button type="button" class="btn-mini" data-property-add data-case-id="${esc(evalCase.id)}">Add expected property</button>
          </div>

          <div class="candidate-outputs-block">
            <p class="block-label">Candidate outputs and scores</p>
            ${state.candidates.map((c) => candidateOutputBlockHtml(evalCase, c)).join('')}
          </div>
        </div>
      `;
    }

    function renderCandidates() {
      const target = el('[data-candidates-list]');
      if (!target) return;
      target.innerHTML = state.candidates
        .map(
          (c) => `
        <div class="candidate-row" data-candidate-id="${esc(c.id)}">
          <input type="text" data-candidate-label data-candidate-id="${esc(c.id)}" value="${esc(c.label)}" aria-label="Candidate label" />
          <button type="button" class="candidate-remove" data-candidate-remove data-candidate-id="${esc(c.id)}">Remove</button>
        </div>
      `,
        )
        .join('');
    }

    function renderCases() {
      const target = el('[data-cases-list]');
      if (!target) return;
      target.innerHTML = state.cases.length
        ? state.cases.map((c) => caseCardHtml(c)).join('')
        : '<p class="clean-note">No cases yet.</p>';
    }

    function refreshCheckBadges() {
      root.querySelectorAll<HTMLElement>('[data-check-status]').forEach((badge) => {
        const caseId = badge.getAttribute('data-case-id');
        const candidateId = badge.getAttribute('data-candidate-id');
        const propertyId = badge.getAttribute('data-property-id');
        const evalCase = state.cases.find((c) => c.id === caseId);
        const property = evalCase?.expectedProperties.find((p) => p.id === propertyId);
        if (!evalCase || !property || !candidateId) return;
        const outputText = state.outputs[outputKey(candidateId, evalCase.id)] ?? '';
        const result = runCheck(property, outputText);
        badge.setAttribute('data-status', result.status);
        badge.textContent = `${CHECK_TYPE_LABELS[property.checkType]}, ${result.status}. ${result.detail}`;
      });
    }

    function renderResults() {
      const target = el('[data-results-output]');
      if (!target) return;
      const aggregates = computeAllAggregates(state);
      target.innerHTML = aggregates
        .map(
          (a) => `
        <div class="candidate-result-card">
          <p class="verdict-badge" data-verdict="${a.verdict}" aria-live="polite">${esc(VERDICT_TEXT[a.verdict] ?? a.verdict)}</p>
          <p class="result-label">${esc(a.candidateLabel)}</p>
          <div class="stats-row"><span class="stats-label">Scored</span><span class="stats-value">${a.fullyScoredCases} of ${a.totalCases} cases</span></div>
          <div class="stats-row"><span class="stats-label">Raw pass rate</span><span class="stats-value">${(a.rawPassRate * 100).toFixed(1)} percent</span></div>
          <div class="stats-row"><span class="stats-label">Weighted mean</span><span class="stats-value">${(a.weightedMean * 100).toFixed(1)} percent</span></div>
          ${
            a.wilson
              ? `<div class="stats-row"><span class="stats-label">${a.wilson.confidenceLevel} percent confidence interval</span><span class="stats-value">${(a.wilson.lower * 100).toFixed(1)} to ${(a.wilson.upper * 100).toFixed(1)} percent</span></div>`
              : ''
          }
          ${
            a.hasCriticalFailure
              ? `<p class="critical-alert">Critical case failure: ${a.criticalFailures.map((c) => esc(c.title)).join(', ')}. This overrides the pass rate above.</p>`
              : '<p class="clean-note">No critical case failures.</p>'
          }
        </div>
      `,
        )
        .join('');
    }

    function renderCoverage() {
      const target = el('[data-coverage-output]');
      if (!target) return;
      const gaps = computeCoverageGaps(state);
      target.innerHTML = gaps.length
        ? `<ul class="coverage-gaps">${gaps.map((g) => `<li>${esc(g)}</li>`).join('')}</ul>`
        : '<p class="clean-note">No coverage gaps found.</p>';
    }

    function renderDisagreement() {
      const target = el('[data-disagreement-output]');
      if (!target) return;
      const divergence = computeCaseDivergence(state);
      const inconsistencies = computeRubricInconsistencies(state);

      const divergenceHtml = divergence.length
        ? divergence
            .slice(0, 5)
            .map(
              (d) => `
          <div class="divergence-row">
            <p class="divergence-case">${esc(d.caseTitle)}</p>
            <p class="divergence-detail">Spread ${(d.spread * 100).toFixed(1)} percentage points. ${d.scores.map((s) => `${esc(s.candidateLabel)} ${(s.score * 100).toFixed(0)} percent`).join(', ')}.</p>
          </div>`,
            )
            .join('')
        : '<p class="clean-note">No case is fully scored by two or more candidates yet.</p>';

      const inconsistencyHtml = inconsistencies.length
        ? inconsistencies
            .map(
              (i) =>
                `<p class="divergence-detail">${esc(i.candidateLabel)}, concern "${esc(i.concern)}": ${i.passCount} pass, ${i.failCount} fail across cases.</p>`,
            )
            .join('')
        : '<p class="clean-note">No rubric inconsistency found.</p>';

      target.innerHTML = `
        <p class="block-label">Biggest divergence between candidates</p>
        ${divergenceHtml}
        <p class="block-label">Rubric inconsistency by concern</p>
        ${inconsistencyHtml}
      `;
    }

    function renderMde() {
      const target = el('[data-mde-output]');
      if (!target) return;
      const aggregates = computeAllAggregates(state);
      const scored = aggregates.filter((a) => a.fullyScoredCases > 0);
      target.innerHTML = scored.length
        ? scored
            .map((a) => {
              const mde = evalSetMde(state, a.rawPassRate);
              return `<div class="stats-row"><span class="stats-label">${esc(a.candidateLabel)}</span><span class="stats-value">${(mde.delta * 100).toFixed(1)} percentage points<span class="stats-method">${esc(mde.method)}</span></span></div>`;
            })
            .join('')
        : '<p class="clean-note">Score at least one candidate to see the detectable regression.</p>';
    }

    function renderAnalysis() {
      renderResults();
      renderCoverage();
      renderDisagreement();
      renderMde();
    }

    function toggleGate() {
      const empty = el('[data-empty-wrapper]');
      const gated = el('[data-gated]');
      const hasCases = state.cases.length > 0;
      if (empty) (empty as HTMLElement).hidden = hasCases;
      if (gated) (gated as HTMLElement).hidden = !hasCases;
    }

    function renderAll() {
      renderCandidates();
      renderCases();
      renderAnalysis();
      toggleGate();
    }

    /* ---------------------------------------------------------------
     * Events
     * ------------------------------------------------------------- */

    const SCALAR_NAMES = ['name', 'description', 'concerns', 'passThreshold', 'confidenceLevel', 'power'];

    root.addEventListener('input', (event) => {
      const target = event.target as HTMLElement;
      if (!target) return;
      const name = target.getAttribute('name');

      if (name && SCALAR_NAMES.includes(name)) {
        readScalarsFromDom();
        renderAnalysis();
        return;
      }

      const caseId = target.getAttribute('data-case-id');
      const propertyId = target.getAttribute('data-property-id');
      const candidateId = target.getAttribute('data-candidate-id');

      if (target.hasAttribute('data-case-title') && caseId) {
        state = withCaseUpdated(state, caseId, { title: (target as HTMLInputElement).value });
      } else if (target.hasAttribute('data-case-input') && caseId) {
        state = withCaseUpdated(state, caseId, { input: (target as HTMLTextAreaElement).value });
      } else if (target.hasAttribute('data-property-description') && caseId && propertyId) {
        state = withPropertyUpdated(state, caseId, propertyId, { description: (target as HTMLInputElement).value });
      } else if (target.hasAttribute('data-property-concern') && caseId && propertyId) {
        state = withPropertyUpdated(state, caseId, propertyId, { concern: (target as HTMLInputElement).value });
        renderAnalysis();
      } else if (target.hasAttribute('data-property-weight') && caseId && propertyId) {
        const weight = Number((target as HTMLInputElement).value) || 1;
        state = withPropertyUpdated(state, caseId, propertyId, { weight });
        renderAnalysis();
      } else if (target.hasAttribute('data-check-value') && caseId && propertyId) {
        state = withPropertyUpdated(state, caseId, propertyId, { check: { value: (target as HTMLInputElement).value } as never });
        refreshCheckBadges();
        renderAnalysis();
      } else if (target.hasAttribute('data-check-flags') && caseId && propertyId) {
        state = withPropertyUpdated(state, caseId, propertyId, { check: { flags: (target as HTMLInputElement).value } as never });
        refreshCheckBadges();
        renderAnalysis();
      } else if (target.hasAttribute('data-check-minlength') && caseId && propertyId) {
        const raw = (target as HTMLInputElement).value;
        state = withPropertyUpdated(state, caseId, propertyId, { check: { minLength: raw === '' ? null : Number(raw) } as never });
        refreshCheckBadges();
        renderAnalysis();
      } else if (target.hasAttribute('data-check-maxlength') && caseId && propertyId) {
        const raw = (target as HTMLInputElement).value;
        state = withPropertyUpdated(state, caseId, propertyId, { check: { maxLength: raw === '' ? null : Number(raw) } as never });
        refreshCheckBadges();
        renderAnalysis();
      } else if (target.hasAttribute('data-check-requiredkeys') && caseId && propertyId) {
        const keys = (target as HTMLInputElement).value
          .split(',')
          .map((k) => k.trim())
          .filter(Boolean);
        state = withPropertyUpdated(state, caseId, propertyId, { check: { requiredKeys: keys } as never });
        refreshCheckBadges();
        renderAnalysis();
      } else if (target.hasAttribute('data-output') && caseId && candidateId) {
        state = withOutputSet(state, candidateId, caseId, (target as HTMLTextAreaElement).value);
        refreshCheckBadges();
        renderAnalysis();
      } else if (target.hasAttribute('data-manual-scale') && caseId && candidateId && propertyId) {
        const raw = (target as HTMLInputElement).value;
        const scale = raw === '' ? undefined : Number(raw);
        state = withManualScoreSet(state, candidateId, caseId, propertyId, scale === undefined ? undefined : { scale });
        renderAnalysis();
      } else if (target.hasAttribute('data-candidate-label') && candidateId) {
        state = withCandidateUpdated(state, candidateId, { label: (target as HTMLInputElement).value });
        root.querySelectorAll<HTMLElement>(`[data-candidate-output-label][data-candidate-id="${candidateId}"]`).forEach((labelEl) => {
          labelEl.textContent = (target as HTMLInputElement).value;
        });
        renderAnalysis();
      }
    });

    root.addEventListener('change', (event) => {
      const target = event.target as HTMLElement;
      if (!target) return;
      const name = target.getAttribute('name');

      if (name === 'scoreMode') {
        readScalarsFromDom();
        // A different rubric changes what a manual score even means, so
        // stale scores under the old rubric are cleared rather than
        // silently reinterpreted.
        state.manualScores = {};
        renderAll();
        return;
      }
      if (name && SCALAR_NAMES.includes(name)) {
        readScalarsFromDom();
        renderAnalysis();
        return;
      }

      const caseId = target.getAttribute('data-case-id');
      const propertyId = target.getAttribute('data-property-id');
      const candidateId = target.getAttribute('data-candidate-id');

      if (target.hasAttribute('data-case-critical') && caseId) {
        state = withCaseUpdated(state, caseId, { critical: (target as HTMLInputElement).checked });
        renderAnalysis();
      } else if (target.hasAttribute('data-property-checktype') && caseId && propertyId) {
        state = withPropertyUpdated(state, caseId, propertyId, { checkType: (target as HTMLSelectElement).value as never });
        renderCases();
        renderAnalysis();
      } else if (target.hasAttribute('data-check-casesensitive') && caseId && propertyId) {
        state = withPropertyUpdated(state, caseId, propertyId, {
          check: { caseSensitive: (target as HTMLInputElement).checked } as never,
        });
        refreshCheckBadges();
        renderAnalysis();
      } else if (target.hasAttribute('data-check-negate') && caseId && propertyId) {
        state = withPropertyUpdated(state, caseId, propertyId, { check: { negate: (target as HTMLInputElement).checked } as never });
        refreshCheckBadges();
        renderAnalysis();
      } else if (target.hasAttribute('data-manual-passfail') && caseId && candidateId && propertyId) {
        const value = (target as HTMLSelectElement).value as '' | 'pass' | 'fail';
        state = withManualScoreSet(state, candidateId, caseId, propertyId, value === '' ? undefined : { passFail: value });
        renderAnalysis();
      }
    });

    root.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement)?.closest<HTMLElement>('button');
      if (!button) return;

      if (button.hasAttribute('data-case-add')) {
        state = withCaseAdded(state);
        renderCases();
        renderAnalysis();
        toggleGate();
      } else if (button.hasAttribute('data-case-remove')) {
        const caseId = button.getAttribute('data-case-id');
        if (caseId) {
          state = withCaseRemoved(state, caseId);
          renderCases();
          renderAnalysis();
          toggleGate();
        }
      } else if (button.hasAttribute('data-property-add')) {
        const caseId = button.getAttribute('data-case-id');
        if (caseId) {
          state = withPropertyAdded(state, caseId);
          renderCases();
          renderAnalysis();
        }
      } else if (button.hasAttribute('data-property-remove')) {
        const caseId = button.getAttribute('data-case-id');
        const propertyId = button.getAttribute('data-property-id');
        if (caseId && propertyId) {
          state = withPropertyRemoved(state, caseId, propertyId);
          renderCases();
          renderAnalysis();
        }
      } else if (button.hasAttribute('data-candidate-add')) {
        state = withCandidateAdded(state);
        renderCandidates();
        renderCases();
        renderAnalysis();
      } else if (button.hasAttribute('data-candidate-remove')) {
        const candidateId = button.getAttribute('data-candidate-id');
        if (candidateId) {
          state = withCandidateRemoved(state, candidateId);
          renderCandidates();
          renderCases();
          renderAnalysis();
        }
      }
    });

    el('[data-load-sample]')?.addEventListener('click', () => {
      const id = el<HTMLSelectElement>('[data-sample-select]')?.value ?? SAMPLES[0].id;
      state = sampleState(id);
      writeScalarsToDom();
      const teaches = el('[data-teaches]');
      if (teaches) teaches.textContent = getSample(id)?.teaches ?? '';
      renderAll();
    });

    // EmptyState dispatches this same event when its own sample
    // affordance is used, so both entry points share one handler.
    root.addEventListener('workbench:load-sample', () => {
      state = sampleState(SAMPLES[0].id);
      writeScalarsToDom();
      const teaches = el('[data-teaches]');
      if (teaches) teaches.textContent = SAMPLES[0].teaches;
      renderAll();
    });

    el('[data-reset]')?.addEventListener('click', () => {
      state = reset();
      writeScalarsToDom();
      const teaches = el('[data-teaches]');
      if (teaches) teaches.textContent = '';
      renderAll();
    });

    el('[data-import]')?.addEventListener('click', () => {
      const text = root.querySelector<HTMLTextAreaElement>('[name="importText"]')?.value ?? '';
      const status = el('[data-import-status]');
      const result = importState(text);
      if (!result.ok) {
        if (status) status.textContent = `Import failed. ${result.error}`;
        return;
      }
      state = result.state;
      writeScalarsToDom();
      if (status) status.textContent = 'Evaluation set imported.';
      renderAll();
    });

    // ExportBar asks, the tool answers. See ExportBar.astro.
    root.addEventListener('workbench:export', ((event: CustomEvent) => {
      const { format, resolve } = event.detail ?? {};
      if (typeof resolve !== 'function') return;
      readScalarsFromDom();
      const fmt = format === 'markdown' ? 'markdown' : 'json';
      resolve(serialize(state, fmt));
    }) as EventListener);

    renderAll();
  }
</script>
