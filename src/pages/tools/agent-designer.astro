---
// Agent Designer.
// PRD: tools-nixfred-prds/tools/08-AGENT-DESIGNER.md
//
// CONSOLIDATION, per 01-INFORMATION-ARCHITECTURE.md: Agent Observatory,
// Mission Control, Fleet Command, autonomy, and handoffs are modes of
// this one tool, not separate tools. The PRD names four modes and this
// page implements all four as ordered sections on one page rather than
// as switching tabs, so a keyboard user or a screen reader gets the
// whole document in one pass:
//
//   Architecture: role, instructions, tools, memory, triggers, and
//   exit conditions. This is Purpose, Memory and triggers, Tools,
//   Autonomy, Handoffs, Limits, and Failure below.
//   Mission: steps and tool calls for a sample task, typed as
//   observation, decision, action, result, or memory, with loops that
//   carry a limit and an exit condition.
//   Team: delegation and handoffs. Solo is the default and a complete
//   answer on its own (acceptance criterion: "a single agent sample
//   works before team mode is introduced"), so this section is a
//   closed <details> until a teammate is added.
//   Observatory: the mission above expanded into a timeline, a
//   simulated cost count, failures, and recovery.
//
// This is a specification and a linter for that specification, not a
// running agent. Nothing here calls a model or executes a tool call.
// "Simulate" means a deterministic expansion of the steps you
// authored, never a prediction of real behavior, and the page says so.
import ToolLayout from '../../layouts/ToolLayout.astro';
import Field from '../../components/kit/Field.astro';
import ResultPanel from '../../components/kit/ResultPanel.astro';
import HelpNote from '../../components/kit/HelpNote.astro';
import WarningNote from '../../components/kit/WarningNote.astro';
import ExportBar from '../../components/kit/ExportBar.astro';
import { getTool } from '../../data/registry';
import { SAMPLES, AUTONOMY_LEVELS, AUTONOMY_LABELS } from '../../lib/tools/agent-designer';

const tool = getTool('agent-designer')!;

const autonomyOptions = AUTONOMY_LEVELS.map((level) => ({ value: level, label: AUTONOMY_LABELS[level] }));
---

<ToolLayout tool={tool}>
  <div class="designer" data-designer>
    <div class="toolbar">
      <div class="toolbar-group">
        <label class="label" for="sample">Sample agent</label>
        <select id="sample" data-sample-select>
          {SAMPLES.map((s) => <option value={s.id}>{s.name}</option>)}
        </select>
        <button type="button" class="btn btn-primary" data-load-sample>
          Load sample
        </button>
      </div>
      <div class="toolbar-group">
        <button type="button" class="btn" data-copy-spec>
          Copy specification
        </button>
        <button type="button" class="btn" data-reset>Reset</button>
      </div>
    </div>

    <nav class="mode-nav" aria-label="Tool modes">
      <a href="#architecture-mode">Architecture</a>
      <a href="#mission-mode">Mission</a>
      <a href="#team-mode">Team</a>
      <a href="#observatory-mode">Observatory</a>
    </nav>

    <p class="teaches" data-teaches role="status" aria-live="polite"></p>

    <WarningNote severity="info" title="What this tool does not do">
      This is a specification and a linter for that specification. It
      does not call a model and does not execute a tool call.
      Wherever this page says simulate, it means a deterministic
      expansion of the steps you authored, exactly as you wrote them.
      It is not a prediction of what a real model or a real tool call
      would do.
    </WarningNote>

    <Field label="Agent name" name="agent-name" hint="A short working title, used in the exported specification." />

    <section class="mode" id="architecture-mode" aria-labelledby="architecture-mode-heading">
      <h2 class="mode-heading" id="architecture-mode-heading">Architecture</h2>
      <p class="mode-intro">
        Role, instructions, tools, memory, triggers, and exit
        conditions. Everything the agent is, before it ever runs.
      </p>

      <section class="panel-section" aria-labelledby="purpose-heading">
        <h3 id="purpose-heading">Purpose</h3>
        <p class="section-lede">
          What the agent is for, what it must never do, what done looks
          like, and how success is measured.
        </p>
        <Field
          label="What the agent is for"
          name="purpose-summary"
          type="textarea"
          rows={2}
          hint="State the outcome, not the mechanism."
        />
        <Field
          label="What it must never do"
          name="purpose-must-never"
          type="textarea"
          rows={2}
          hint="A hard boundary, stated as a rule an engineer could check the build against."
        />
        <Field
          label="What done looks like"
          name="purpose-done-looks-like"
          type="textarea"
          rows={2}
          hint="What exists, or what changed, at the end of one successful run."
        />
        <Field
          label="How success is measured"
          name="purpose-success-measure"
          type="textarea"
          rows={2}
          hint="A measure that holds across many runs, not just one."
        />
      </section>

      <section class="panel-section" aria-labelledby="memory-heading">
        <h3 id="memory-heading">Memory and triggers</h3>
        <p class="section-lede">
          What the agent remembers, and what starts a run. Both are
          named directly in the PRD as first class parts of the
          architecture, not incidental detail.
        </p>
        <Field
          label="What it remembers"
          name="agent-memory"
          type="textarea"
          rows={2}
          hint="What persists between steps, between runs, or not at all, and for how long."
        />
        <Field
          label="What starts a run"
          name="agent-triggers"
          type="textarea"
          rows={2}
          hint="An event, a schedule, an incoming message, or a manual call."
        />
      </section>

      <section class="panel-section" aria-labelledby="tools-heading">
        <h3 id="tools-heading">Tools</h3>
        <p class="section-lede">
          Every tool the agent can call. Name each one plainly, state
          what it needs and what it returns, and mark whether it
          mutates anything, whether that mutation can be undone, and
          whether it needs a human to confirm it first.
        </p>
        <div data-tools-list></div>
        <button type="button" class="btn btn-add" data-add-tool>Add tool</button>
      </section>

      <section class="panel-section" aria-labelledby="autonomy-heading">
        <h3 id="autonomy-heading">Autonomy</h3>
        <p class="section-lede">
          The level this agent runs at, checked against the tool list
          above. A mutating, irreversible tool combined with full
          autonomy is a contradiction, and it is flagged loudly rather
          than accepted quietly.
        </p>
        <Field label="Autonomy level" name="autonomy-level" type="select" options={autonomyOptions} />
        <p class="autonomy-description mono" data-autonomy-description></p>
        <Field
          label="Rationale for this level"
          name="autonomy-rationale"
          type="textarea"
          rows={2}
          hint="Why this level, not a stricter or looser one."
        />
      </section>

      <section class="panel-section" aria-labelledby="handoffs-heading">
        <h3 id="handoffs-heading">Handoffs</h3>
        <p class="section-lede">
          When this agent escalates to a human or to another agent,
          what context moves with the handoff, and who owns the task
          afterward. An escalation path with no owner is where work
          gets dropped silently, so it is flagged.
        </p>
        <div data-handoffs-list></div>
        <button type="button" class="btn btn-add" data-add-handoff>Add handoff</button>
      </section>

      <section class="panel-section" aria-labelledby="limits-heading">
        <h3 id="limits-heading">Limits</h3>
        <p class="section-lede">
          The budget this agent runs inside, and the conditions that
          stop it. An agent with no stop condition can keep running
          indefinitely once started.
        </p>
        <div class="limits-grid">
          <Field label="Step budget" name="limits-step-budget" type="number" min={0} step={1} hint="Maximum tool calls in one run." />
          <Field label="Time budget, minutes" name="limits-time-budget" type="number" min={0} step={1} hint="Maximum wall clock minutes in one run." />
          <Field label="Cost ceiling" name="limits-cost-ceiling" hint={'For example, "$0.50 per ticket".'} />
        </div>
        <Field
          label="Retry policy"
          name="limits-retry-policy"
          type="textarea"
          rows={2}
          hint="What happens when a tool call fails once, and how many times it is retried."
        />
        <Field
          label="Stop conditions"
          name="limits-stop-conditions"
          type="textarea"
          rows={3}
          hint="One condition per line. At least one is required."
        />
      </section>

      <section class="panel-section" aria-labelledby="failure-heading">
        <h3 id="failure-heading">Failure</h3>
        <p class="section-lede">
          What the agent does when a tool call fails, when it is
          uncertain rather than wrong, and when it detects it has
          looped. An agent with no defined uncertain behavior is
          incomplete.
        </p>
        <Field label="When a tool call fails" name="failure-tool-failure" type="textarea" rows={2} />
        <Field
          label="When the agent is uncertain"
          name="failure-uncertainty"
          type="textarea"
          rows={2}
          hint="Uncertain is not the same as wrong. State what it does when it does not know."
        />
        <Field label="When the agent detects a loop" name="failure-loop" type="textarea" rows={2} />
      </section>
    </section>

    <section class="mode" id="mission-mode" aria-labelledby="mission-mode-heading">
      <h2 class="mode-heading" id="mission-mode-heading">Mission</h2>
      <p class="mode-intro">
        Step through one sample task as a deterministic walkthrough of
        the agent above. Every step is typed as an observation, a
        decision, an action, a result, or a memory update, so the five
        stay distinct rather than collapsing into one generic log
        line. Every action must name a tool from Architecture, or it
        counts as unauthorized. Steps that repeat belong to a loop, and
        a loop needs both a limit and an exit condition below.
      </p>

      <Field
        label="Sample task"
        name="mission-task"
        type="textarea"
        rows={2}
        hint="The one task this walkthrough steps through."
      />

      <section class="panel-section" aria-labelledby="loops-heading">
        <h3 id="loops-heading">Loops</h3>
        <p class="section-lede">
          A labeled block of steps that repeats. Every loop used below
          needs a maximum iteration count and a stated exit condition;
          the limit is a backstop, not a substitute for the condition.
        </p>
        <div data-loops-list></div>
        <button type="button" class="btn btn-add" data-add-loop>Add loop</button>
      </section>

      <section class="panel-section" aria-labelledby="steps-heading">
        <h3 id="steps-heading">Steps</h3>
        <p class="section-lede">
          The walkthrough itself, in order. An action step with no
          matching tool is flagged as unauthorized below.
        </p>
        <div data-steps-list></div>
        <button type="button" class="btn btn-add" data-add-step>Add step</button>
      </section>
    </section>

    <section class="mode" id="team-mode" aria-labelledby="team-mode-heading">
      <h2 class="mode-heading" id="team-mode-heading">Team</h2>
      <p class="mode-intro">
        Delegation and handoffs. Solo is the default and a complete
        answer on its own: a single agent works before team mode is
        ever introduced. Open this only once the mission actually
        involves another agent.
      </p>
      <details class="team-details">
        <summary class="team-summary">Team roster</summary>
        <div class="team-body">
          <p class="section-lede">
            Who else is on the team. The Handoffs panel in Architecture
            already carries what moves and who owns it after a
            handoff; this roster names who they are.
          </p>
          <div data-team-list></div>
          <button type="button" class="btn btn-add" data-add-team>Add teammate</button>
        </div>
      </details>
    </section>

    <section class="mode" id="observatory-mode" aria-labelledby="observatory-mode-heading">
      <h2 class="mode-heading" id="observatory-mode-heading">Observatory</h2>
      <p class="mode-intro">
        The mission above, expanded into an ordered timeline. Not a
        model call and not a benchmark: a mechanical walkthrough of
        what you authored, including where a loop halted at its limit
        and where an action had no matching permission.
      </p>
      <ResultPanel
        title="Simulated run"
        id="observatory-panel"
        description="Every entry keeps the type it was authored with. A loop with a stated limit runs to exactly that many iterations, then stops."
      >
        <div data-observatory-summary></div>
        <div data-timeline></div>
      </ResultPanel>
    </section>

    <ResultPanel
      title="Specification status"
      id="status-panel"
      description="Completeness is every required field filled in. Ready to build also requires zero unresolved critical flags, so a full form with a contradiction still is not ready."
    >
      <p class="ready-line" data-ready-line role="status" aria-live="polite"></p>
      <div class="completeness-bar" data-completeness-bar>
        <span class="completeness-fill" data-completeness-fill></span>
      </div>
      <p class="completeness-label mono" data-completeness-label></p>
      <div data-missing-list></div>
    </ResultPanel>

    <ResultPanel
      title="Risk flags"
      id="flags-panel"
      description="Contradictions the tool can check for automatically, across every mode. Silence here means these specific checks found nothing, not that the design is safe."
    >
      <div data-flags></div>
    </ResultPanel>

    <ResultPanel
      title="Full specification"
      id="spec-panel"
      description="Everything above, in one document. Copyable, and identical to the markdown export below."
    >
      <pre class="spec-preview mono" data-spec-preview></pre>
    </ResultPanel>

    <ExportBar formats={['json', 'markdown']} filename="agent-designer-spec" />

    <HelpNote title="Why does the autonomy level have to match the tool list?">
      <p>
        An autonomy level is a promise about who is watching. Suggest
        only promises nothing acts without a human choosing to. Act
        with confirmation promises a checkpoint before anything
        mutating happens. Fully autonomous promises the opposite: no
        checkpoint at all, ever.
      </p>
      <p>
        A tool list is a set of facts about what the agent can actually
        do. When a fact contradicts a promise, for example an
        irreversible delete sitting inside a fully autonomous agent,
        one of them is wrong. The tool cannot know which one you meant,
        so it flags the contradiction instead of quietly picking a
        side.
      </p>
    </HelpNote>

    <HelpNote title="Why does an action need a matching permission?">
      <p>
        A mission step that says "deletes the file" reads like an
        authorized action right up until you check whether a tool
        called exactly that exists. A typo in a tool reference, or a
        tool the walkthrough assumes but Architecture never defined,
        produces a step that looks fine in prose and does nothing real
        underneath it.
      </p>
      <p>
        Requiring every action to resolve to a real tool from
        Architecture is what makes the mission trustworthy as a
        walkthrough of the agent above it, rather than a separate story
        that happens to sit next to it.
      </p>
    </HelpNote>
  </div>
</ToolLayout>

<style>
  .designer {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-3);
  }

  .toolbar-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  select {
    background: var(--panel);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    font: inherit;
  }

  .btn {
    font: 600 var(--text-xs) var(--font-sans);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }

  .btn:hover {
    color: var(--accent);
    border-color: var(--signal-edge);
  }

  .btn-primary {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  .btn-primary:hover {
    background: var(--accent-strong);
    color: var(--bg);
  }

  .btn-add {
    align-self: flex-start;
  }

  .mode-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  .mode-nav a {
    color: var(--text-faint);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 0.15rem;
  }

  .mode-nav a:hover,
  .mode-nav a:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--signal-edge);
  }

  .teaches {
    color: var(--text-faint);
    font-size: var(--text-sm);
    margin: 0;
    min-height: 1.5em;
  }

  .mode {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-strong);
  }

  .mode-heading {
    font-size: var(--text-2xl);
    margin-bottom: 0;
  }

  .mode-intro {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--measure);
    margin: 0;
  }

  .panel-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    background: var(--panel);
  }

  .panel-section h3 {
    font-size: var(--text-lg);
    margin-bottom: 0;
  }

  .section-lede {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--measure);
    margin-bottom: var(--space-2);
  }

  .limits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-3);
  }

  .autonomy-description {
    font-size: var(--text-sm);
    color: var(--text-dim);
    margin: calc(-1 * var(--space-2)) 0 0;
  }

  .team-details {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    background: var(--panel);
  }

  .team-summary {
    cursor: pointer;
    list-style: none;
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text);
  }

  .team-summary::-webkit-details-marker {
    display: none;
  }

  .team-summary::after {
    content: ', closed. Click to add teammates.';
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--text-faint);
    text-transform: none;
    letter-spacing: 0;
  }

  .team-details[open] .team-summary::after {
    content: ', open.';
  }

  .team-body {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .completeness-bar {
    height: 8px;
    background: var(--chassis-700);
    border-radius: var(--radius-pill);
    overflow: hidden;
    margin: var(--space-2) 0;
  }

  .completeness-fill {
    display: block;
    height: 100%;
    background: var(--accent-deep);
  }

  .completeness-label {
    font-size: var(--text-xs);
    color: var(--text-faint);
    margin: 0 0 var(--space-3);
  }

  .ready-line {
    font-size: var(--text-sm);
    font-weight: 700;
    margin: 0 0 var(--space-2);
  }

  .spec-preview {
    white-space: pre-wrap;
    font-size: var(--text-sm);
    line-height: 1.6;
    max-height: 32rem;
    overflow-y: auto;
    overflow-wrap: anywhere;
    margin: 0;
  }
</style>

{/* Runtime injected markup, meaning anything built by the script below
    as an HTML string, is NOT reached by Astro's scoped CSS. Every class
    the script creates is styled globally here, matching the same
    pattern used by the Prompt Laboratory tool. */}
<style is:global>
  .row {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3);
    margin-bottom: var(--space-3);
    position: relative;
  }

  .row-legend {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-faint);
    padding: 0 var(--space-1);
  }

  .row-remove {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    font: 600 var(--text-xs) var(--font-sans);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-dim);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.2rem 0.55rem;
    cursor: pointer;
  }

  .row-remove:hover {
    color: var(--status-alert);
    border-color: var(--status-alert);
  }

  .row-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .row-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .row-field[hidden] {
    display: none;
  }

  .row-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .row-input {
    width: 100%;
    font-family: var(--font-mono);
    color: var(--text);
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.5rem 0.6rem;
  }

  .row-input:focus-visible {
    border-color: var(--accent);
    outline: none;
  }

  select.row-input {
    cursor: pointer;
  }

  select.row-input:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .row-flags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .row-check {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .row-check input:disabled {
    opacity: 0.4;
  }

  .empty-list-note {
    font-size: var(--text-sm);
    color: var(--text-dim);
    margin: 0 0 var(--space-2);
  }

  .flag {
    display: block;
    border: 1px solid var(--line);
    border-left-width: 3px;
    border-radius: var(--radius);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .flag[data-severity='critical'] {
    border-left-color: var(--status-alert);
  }

  .flag[data-severity='warning'] {
    border-left-color: var(--status-beta);
  }

  .flag[data-severity='info'] {
    border-left-color: var(--readout-700);
  }

  .flag-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    margin-bottom: var(--space-1);
  }

  .flag-severity {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text);
  }

  .flag-panel {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-dim);
  }

  .flag-message {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
    max-width: none;
  }

  .clean-note {
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  .missing-item {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* Observatory timeline. Border color is the second channel; the
     type word itself is always printed too, so nothing here relies on
     color alone. */
  .timeline-entry {
    border: 1px solid var(--line);
    border-left-width: 3px;
    border-radius: var(--radius);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .timeline-entry[data-type='observation'] {
    border-left-color: var(--cat-understand);
  }

  .timeline-entry[data-type='decision'] {
    border-left-color: var(--cat-design);
  }

  .timeline-entry[data-type='action'] {
    border-left-color: var(--accent);
  }

  .timeline-entry[data-type='result'] {
    border-left-color: var(--status-live);
  }

  .timeline-entry[data-type='memory'] {
    border-left-color: var(--cat-operate);
  }

  /* An unauthorized action overrides the type color: the failure is
     the more important fact here. Ordered after the type rules above
     so it wins the cascade for the same element. */
  .timeline-entry[data-authorized='false'] {
    border-left-color: var(--status-alert);
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    margin-bottom: var(--space-1);
  }

  .timeline-order {
    font-size: var(--text-xs);
    color: var(--text-dim);
  }

  .timeline-type {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text);
  }

  .timeline-loop {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .timeline-desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
    max-width: none;
  }

  .timeline-tool {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
    margin: var(--space-1) 0 0;
  }

  .timeline-tool-bad {
    color: var(--status-alert);
  }

  .observatory-line {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
    max-width: none;
  }
</style>

<script>
  import {
    evaluateSpec,
    computeCompleteness,
    isReadyToBuild,
    serialize,
    runMission,
    emptyState,
    sampleState,
    getSample,
    SAMPLES,
    AUTONOMY_LEVELS,
    AUTONOMY_LABELS,
    AUTONOMY_DESCRIPTIONS,
    MISSION_STEP_TYPES,
    MISSION_STEP_LABELS,
    type AgentSpecState,
    type ToolSpec,
    type Handoff,
    type MissionStep,
    type MissionLoop,
    type MissionStepType,
    type TeammateAgent,
    type AutonomyLevel,
  } from '../../lib/tools/agent-designer';

  const root = document.querySelector<HTMLElement>('[data-designer]');
  if (root) {
    const el = <T extends Element>(sel: string) => root.querySelector<T>(sel);
    const byName = <T extends HTMLElement>(name: string) => root.querySelector<T>(`[name="${name}"]`);

    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const escAttr = (s: string) => esc(s).replace(/"/g, '&quot;');

    let rowCounter = 0;
    const nextId = (prefix: string) => `${prefix}-${(rowCounter += 1)}`;

    /* ---------------------------------------------------------------- *
     * Tool rows
     * ---------------------------------------------------------------- */

    function toolRowHtml(tool: ToolSpec, index: number): string {
      return `
        <fieldset class="row" data-tool-row data-tool-id="${escAttr(tool.id)}">
          <legend class="row-legend">Tool ${index + 1}</legend>
          <button type="button" class="row-remove" data-remove-tool aria-label="Remove tool ${index + 1}">Remove</button>
          <div class="row-grid">
            <label class="row-field">
              <span class="row-label">Name</span>
              <input type="text" class="row-input" data-tool-field="name" value="${escAttr(tool.name)}" placeholder="For example, Send email">
            </label>
            <label class="row-field">
              <span class="row-label">Input</span>
              <input type="text" class="row-input" data-tool-field="input" value="${escAttr(tool.input)}" placeholder="What it needs to be called">
            </label>
            <label class="row-field">
              <span class="row-label">Output</span>
              <input type="text" class="row-input" data-tool-field="output" value="${escAttr(tool.output)}" placeholder="What it returns">
            </label>
          </div>
          <div class="row-flags">
            <label class="row-check">
              <input type="checkbox" data-tool-field="mutates" ${tool.mutates ? 'checked' : ''}>
              Mutates something
            </label>
            <label class="row-check">
              <input type="checkbox" data-tool-field="irreversible" ${tool.irreversible ? 'checked' : ''} ${tool.mutates ? '' : 'disabled'}>
              Irreversible
            </label>
            <label class="row-check">
              <input type="checkbox" data-tool-field="needsConfirmation" ${tool.needsConfirmation ? 'checked' : ''}>
              Needs confirmation
            </label>
          </div>
        </fieldset>`;
    }

    function handoffRowHtml(handoff: Handoff, index: number): string {
      return `
        <fieldset class="row" data-handoff-row data-handoff-id="${escAttr(handoff.id)}">
          <legend class="row-legend">Handoff ${index + 1}</legend>
          <button type="button" class="row-remove" data-remove-handoff aria-label="Remove handoff ${index + 1}">Remove</button>
          <div class="row-grid">
            <label class="row-field">
              <span class="row-label">Trigger</span>
              <input type="text" class="row-input" data-handoff-field="trigger" value="${escAttr(handoff.trigger)}" placeholder="The condition that causes escalation">
            </label>
            <label class="row-field">
              <span class="row-label">Escalates to</span>
              <input type="text" class="row-input" data-handoff-field="target" value="${escAttr(handoff.target)}" placeholder="A human role, or another agent">
            </label>
            <label class="row-field">
              <span class="row-label">Context transferred</span>
              <input type="text" class="row-input" data-handoff-field="contextTransferred" value="${escAttr(handoff.contextTransferred)}" placeholder="What information moves with it">
            </label>
            <label class="row-field">
              <span class="row-label">Owner after handoff</span>
              <input type="text" class="row-input" data-handoff-field="owner" value="${escAttr(handoff.owner)}" placeholder="Who is accountable for it now">
            </label>
          </div>
        </fieldset>`;
    }

    function toolOptionsHtml(tools: ToolSpec[], selected: string): string {
      const blank = `<option value="">(choose a tool)</option>`;
      const opts = tools
        .map(
          (t) =>
            `<option value="${escAttr(t.id)}" ${t.id === selected ? 'selected' : ''}>${esc(t.name.trim() || '(unnamed tool)')}</option>`,
        )
        .join('');
      return blank + opts;
    }

    function loopOptionsHtml(loops: MissionLoop[], selected: string): string {
      const blank = `<option value="">(not in a loop)</option>`;
      const opts = loops
        .map(
          (l) =>
            `<option value="${escAttr(l.id)}" ${l.id === selected ? 'selected' : ''}>${esc(l.label.trim() || '(unlabeled loop)')}</option>`,
        )
        .join('');
      return blank + opts;
    }

    function loopRowHtml(loop: MissionLoop, index: number): string {
      return `
        <fieldset class="row" data-loop-row data-loop-id="${escAttr(loop.id)}">
          <legend class="row-legend">Loop ${index + 1}</legend>
          <button type="button" class="row-remove" data-remove-loop aria-label="Remove loop ${index + 1}">Remove</button>
          <div class="row-grid">
            <label class="row-field">
              <span class="row-label">Label</span>
              <input type="text" class="row-input" data-loop-field="label" value="${escAttr(loop.label)}" placeholder="For example, Retry fetch">
            </label>
            <label class="row-field">
              <span class="row-label">Iteration limit</span>
              <input type="number" class="row-input" min="0" step="1" data-loop-field="maxIterations" value="${loop.maxIterations > 0 ? loop.maxIterations : ''}" placeholder="0">
            </label>
            <label class="row-field">
              <span class="row-label">Exit condition</span>
              <input type="text" class="row-input" data-loop-field="exitCondition" value="${escAttr(loop.exitCondition)}" placeholder="What should end this loop first">
            </label>
          </div>
        </fieldset>`;
    }

    function stepRowHtml(step: MissionStep, index: number, tools: ToolSpec[], loops: MissionLoop[]): string {
      const isAction = step.type === 'action';
      return `
        <fieldset class="row" data-step-row data-step-id="${escAttr(step.id)}">
          <legend class="row-legend">Step ${index + 1}</legend>
          <button type="button" class="row-remove" data-remove-step aria-label="Remove step ${index + 1}">Remove</button>
          <div class="row-grid">
            <label class="row-field">
              <span class="row-label">Type</span>
              <select class="row-input" data-step-field="type">
                ${MISSION_STEP_TYPES.map(
                  (t) => `<option value="${t}" ${t === step.type ? 'selected' : ''}>${esc(MISSION_STEP_LABELS[t])}</option>`,
                ).join('')}
              </select>
            </label>
            <label class="row-field">
              <span class="row-label">Description</span>
              <input type="text" class="row-input" data-step-field="description" value="${escAttr(step.description)}" placeholder="What happens at this step">
            </label>
            <label class="row-field" data-step-tool-field ${isAction ? '' : 'hidden'}>
              <span class="row-label">Calls tool</span>
              <select class="row-input" data-step-field="toolId" ${isAction ? '' : 'disabled'}>${toolOptionsHtml(tools, step.toolId)}</select>
            </label>
            <label class="row-field">
              <span class="row-label">Part of loop</span>
              <select class="row-input" data-step-field="loopId">${loopOptionsHtml(loops, step.loopId)}</select>
            </label>
          </div>
        </fieldset>`;
    }

    function teammateRowHtml(member: TeammateAgent, index: number): string {
      return `
        <fieldset class="row" data-team-row data-team-id="${escAttr(member.id)}">
          <legend class="row-legend">Teammate ${index + 1}</legend>
          <button type="button" class="row-remove" data-remove-team aria-label="Remove teammate ${index + 1}">Remove</button>
          <div class="row-grid">
            <label class="row-field">
              <span class="row-label">Name</span>
              <input type="text" class="row-input" data-team-field="name" value="${escAttr(member.name)}" placeholder="For example, Billing agent">
            </label>
            <label class="row-field">
              <span class="row-label">Role</span>
              <input type="text" class="row-input" data-team-field="role" value="${escAttr(member.role)}" placeholder="What this teammate is responsible for">
            </label>
          </div>
        </fieldset>`;
    }

    function renderToolRows(tools: ToolSpec[]) {
      const list = el('[data-tools-list]');
      if (!list) return;
      list.innerHTML = tools.length
        ? tools.map((t, i) => toolRowHtml(t, i)).join('')
        : '<p class="empty-list-note">No tools yet. Add at least one.</p>';
    }

    function renderHandoffRows(handoffs: Handoff[]) {
      const list = el('[data-handoffs-list]');
      if (!list) return;
      list.innerHTML = handoffs.length
        ? handoffs.map((h, i) => handoffRowHtml(h, i)).join('')
        : '<p class="empty-list-note">No handoffs yet. Most bounded agents need at least one escalation path.</p>';
    }

    function renderLoopRows(loops: MissionLoop[]) {
      const list = el('[data-loops-list]');
      if (!list) return;
      list.innerHTML = loops.length
        ? loops.map((l, i) => loopRowHtml(l, i)).join('')
        : '<p class="empty-list-note">No loops yet. Most missions do not need one.</p>';
    }

    function renderStepRows(steps: MissionStep[], tools: ToolSpec[], loops: MissionLoop[]) {
      const list = el('[data-steps-list]');
      if (!list) return;
      list.innerHTML = steps.length
        ? steps.map((s, i) => stepRowHtml(s, i, tools, loops)).join('')
        : '<p class="empty-list-note">No steps yet. Add at least one to produce a timeline in Observatory.</p>';
    }

    function renderTeamRows(team: TeammateAgent[]) {
      const list = el('[data-team-list]');
      if (!list) return;
      list.innerHTML = team.length
        ? team.map((t, i) => teammateRowHtml(t, i)).join('')
        : '<p class="empty-list-note">Solo agent. No teammates defined, and none are required.</p>';
    }

    /* ---------------------------------------------------------------- *
     * Reading and writing state
     * ---------------------------------------------------------------- */

    function readTools(): ToolSpec[] {
      return Array.from(root.querySelectorAll<HTMLElement>('[data-tool-row]')).map((row) => ({
        id: row.dataset.toolId ?? nextId('tool'),
        name: row.querySelector<HTMLInputElement>('[data-tool-field="name"]')?.value ?? '',
        input: row.querySelector<HTMLInputElement>('[data-tool-field="input"]')?.value ?? '',
        output: row.querySelector<HTMLInputElement>('[data-tool-field="output"]')?.value ?? '',
        mutates: row.querySelector<HTMLInputElement>('[data-tool-field="mutates"]')?.checked ?? false,
        irreversible: row.querySelector<HTMLInputElement>('[data-tool-field="irreversible"]')?.checked ?? false,
        needsConfirmation:
          row.querySelector<HTMLInputElement>('[data-tool-field="needsConfirmation"]')?.checked ?? false,
      }));
    }

    function readHandoffs(): Handoff[] {
      return Array.from(root.querySelectorAll<HTMLElement>('[data-handoff-row]')).map((row) => ({
        id: row.dataset.handoffId ?? nextId('handoff'),
        trigger: row.querySelector<HTMLInputElement>('[data-handoff-field="trigger"]')?.value ?? '',
        target: row.querySelector<HTMLInputElement>('[data-handoff-field="target"]')?.value ?? '',
        contextTransferred:
          row.querySelector<HTMLInputElement>('[data-handoff-field="contextTransferred"]')?.value ?? '',
        owner: row.querySelector<HTMLInputElement>('[data-handoff-field="owner"]')?.value ?? '',
      }));
    }

    function readLoops(): MissionLoop[] {
      return Array.from(root.querySelectorAll<HTMLElement>('[data-loop-row]')).map((row) => ({
        id: row.dataset.loopId ?? nextId('loop'),
        label: row.querySelector<HTMLInputElement>('[data-loop-field="label"]')?.value ?? '',
        maxIterations:
          Number(row.querySelector<HTMLInputElement>('[data-loop-field="maxIterations"]')?.value ?? 0) || 0,
        exitCondition: row.querySelector<HTMLInputElement>('[data-loop-field="exitCondition"]')?.value ?? '',
      }));
    }

    function readSteps(): MissionStep[] {
      return Array.from(root.querySelectorAll<HTMLElement>('[data-step-row]')).map((row) => ({
        id: row.dataset.stepId ?? nextId('step'),
        type: (row.querySelector<HTMLSelectElement>('[data-step-field="type"]')?.value ??
          'observation') as MissionStepType,
        description: row.querySelector<HTMLInputElement>('[data-step-field="description"]')?.value ?? '',
        toolId: row.querySelector<HTMLSelectElement>('[data-step-field="toolId"]')?.value ?? '',
        loopId: row.querySelector<HTMLSelectElement>('[data-step-field="loopId"]')?.value ?? '',
      }));
    }

    function readTeam(): TeammateAgent[] {
      return Array.from(root.querySelectorAll<HTMLElement>('[data-team-row]')).map((row) => ({
        id: row.dataset.teamId ?? nextId('team'),
        name: row.querySelector<HTMLInputElement>('[data-team-field="name"]')?.value ?? '',
        role: row.querySelector<HTMLInputElement>('[data-team-field="role"]')?.value ?? '',
      }));
    }

    function readState(): AgentSpecState {
      const level = (byName<HTMLSelectElement>('autonomy-level')?.value ?? 'suggest-only') as AutonomyLevel;
      return {
        name: byName<HTMLInputElement>('agent-name')?.value ?? '',
        purpose: {
          summary: byName<HTMLTextAreaElement>('purpose-summary')?.value ?? '',
          mustNever: byName<HTMLTextAreaElement>('purpose-must-never')?.value ?? '',
          doneLooksLike: byName<HTMLTextAreaElement>('purpose-done-looks-like')?.value ?? '',
          successMeasure: byName<HTMLTextAreaElement>('purpose-success-measure')?.value ?? '',
        },
        memory: byName<HTMLTextAreaElement>('agent-memory')?.value ?? '',
        triggers: byName<HTMLTextAreaElement>('agent-triggers')?.value ?? '',
        tools: readTools(),
        autonomy: {
          level: AUTONOMY_LEVELS.includes(level) ? level : 'suggest-only',
          rationale: byName<HTMLTextAreaElement>('autonomy-rationale')?.value ?? '',
        },
        handoffs: readHandoffs(),
        limits: {
          stepBudget: Number(byName<HTMLInputElement>('limits-step-budget')?.value ?? 0) || 0,
          timeBudgetMinutes: Number(byName<HTMLInputElement>('limits-time-budget')?.value ?? 0) || 0,
          costCeiling: byName<HTMLInputElement>('limits-cost-ceiling')?.value ?? '',
          retryPolicy: byName<HTMLTextAreaElement>('limits-retry-policy')?.value ?? '',
          stopConditions: (byName<HTMLTextAreaElement>('limits-stop-conditions')?.value ?? '')
            .split('\n')
            .map((s) => s.trim())
            .filter(Boolean),
        },
        failure: {
          onToolFailure: byName<HTMLTextAreaElement>('failure-tool-failure')?.value ?? '',
          onUncertainty: byName<HTMLTextAreaElement>('failure-uncertainty')?.value ?? '',
          onLoopDetected: byName<HTMLTextAreaElement>('failure-loop')?.value ?? '',
        },
        mission: {
          task: byName<HTMLTextAreaElement>('mission-task')?.value ?? '',
          steps: readSteps(),
          loops: readLoops(),
        },
        team: readTeam(),
      };
    }

    function writeState(state: AgentSpecState) {
      const setValue = (name: string, value: string) => {
        const field = byName<HTMLInputElement | HTMLTextAreaElement>(name);
        if (field) field.value = value;
      };

      setValue('agent-name', state.name);
      setValue('purpose-summary', state.purpose.summary);
      setValue('purpose-must-never', state.purpose.mustNever);
      setValue('purpose-done-looks-like', state.purpose.doneLooksLike);
      setValue('purpose-success-measure', state.purpose.successMeasure);
      setValue('agent-memory', state.memory);
      setValue('agent-triggers', state.triggers);
      setValue('autonomy-level', state.autonomy.level);
      setValue('autonomy-rationale', state.autonomy.rationale);
      setValue('limits-step-budget', state.limits.stepBudget > 0 ? String(state.limits.stepBudget) : '');
      setValue(
        'limits-time-budget',
        state.limits.timeBudgetMinutes > 0 ? String(state.limits.timeBudgetMinutes) : '',
      );
      setValue('limits-cost-ceiling', state.limits.costCeiling);
      setValue('limits-retry-policy', state.limits.retryPolicy);
      setValue('limits-stop-conditions', state.limits.stopConditions.join('\n'));
      setValue('failure-tool-failure', state.failure.onToolFailure);
      setValue('failure-uncertainty', state.failure.onUncertainty);
      setValue('failure-loop', state.failure.onLoopDetected);
      setValue('mission-task', state.mission.task);

      renderToolRows(state.tools);
      renderHandoffRows(state.handoffs);
      renderLoopRows(state.mission.loops);
      renderStepRows(state.mission.steps, state.tools, state.mission.loops);
      renderTeamRows(state.team);
      updateAutonomyDescription();
    }

    /* ---------------------------------------------------------------- *
     * Rendering results
     * ---------------------------------------------------------------- */

    function updateAutonomyDescription() {
      const level = (byName<HTMLSelectElement>('autonomy-level')?.value ?? 'suggest-only') as AutonomyLevel;
      const description = el('[data-autonomy-description]');
      if (description) description.textContent = AUTONOMY_DESCRIPTIONS[level] ?? '';
    }

    // A step's tool select and loop select list OTHER rows' data, so
    // they need refreshing whenever a tool is added, removed, or
    // renamed, or a loop is added, removed, or relabeled. Only the
    // <option> lists are rewritten, and the row's own current value is
    // preserved when it still exists, so this never disturbs whatever
    // the user is typing elsewhere, including in the very same row.
    function refreshStepOptions() {
      const tools = readTools();
      const loops = readLoops();
      root.querySelectorAll<HTMLElement>('[data-step-row]').forEach((row) => {
        const toolSelect = row.querySelector<HTMLSelectElement>('[data-step-field="toolId"]');
        const loopSelect = row.querySelector<HTMLSelectElement>('[data-step-field="loopId"]');
        if (toolSelect) toolSelect.innerHTML = toolOptionsHtml(tools, toolSelect.value);
        if (loopSelect) loopSelect.innerHTML = loopOptionsHtml(loops, loopSelect.value);
      });
    }

    function renderCompleteness(state: AgentSpecState) {
      const completeness = computeCompleteness(state);
      const fill = el<HTMLElement>('[data-completeness-fill]');
      const label = el('[data-completeness-label]');
      const missing = el('[data-missing-list]');
      if (fill) fill.style.width = `${completeness.score}%`;
      if (label) {
        label.textContent = `${completeness.score} percent complete, ${completeness.filled} of ${completeness.total} required fields.`;
      }
      if (missing) {
        missing.innerHTML = completeness.missing.length
          ? `<p class="missing-item">Missing: ${completeness.missing.map(esc).join('. ')}.</p>`
          : '<p class="clean-note">Every required field is filled in.</p>';
      }
      return completeness;
    }

    function renderFlags(state: AgentSpecState) {
      const flags = evaluateSpec(state);
      const target = el('[data-flags]');
      if (target) {
        target.innerHTML = flags.length
          ? flags
              .map(
                (f) => `
          <div class="flag" data-severity="${f.severity}">
            <div class="flag-head">
              <span class="flag-severity">${esc(f.severity)}</span>
              <span class="flag-panel">${esc(f.panel)} panel</span>
            </div>
            <p class="flag-message">${esc(f.message)}</p>
          </div>`,
              )
              .join('')
          : '<p class="clean-note">No contradictions detected by these checks. That is not the same as a safe design; it means these specific rules found nothing to object to.</p>';
      }
      return flags;
    }

    function renderReadyLine(state: AgentSpecState) {
      const line = el('[data-ready-line]');
      if (!line) return;
      const ready = isReadyToBuild(state);
      line.textContent = ready
        ? 'Ready to build. An engineer could read this specification and build the agent.'
        : 'Not ready to build yet. See the missing fields and risk flags below.';
    }

    function renderObservatory(state: AgentSpecState) {
      const run = runMission(state.mission, state.tools);

      const timeline = el('[data-timeline]');
      if (timeline) {
        timeline.innerHTML = run.timeline.length
          ? run.timeline
              .map((entry) => {
                const loopNote = entry.loopLabel ? `${esc(entry.loopLabel)}, iteration ${entry.iteration}` : 'runs once';
                const toolLine =
                  entry.type === 'action'
                    ? `<p class="timeline-tool ${entry.authorized ? '' : 'timeline-tool-bad'}">${
                        entry.authorized ? `Calls ${esc(entry.toolName)}` : 'UNAUTHORIZED, no matching tool'
                      }</p>`
                    : '';
                return `
            <div class="timeline-entry" data-type="${entry.type}" data-authorized="${entry.authorized}">
              <div class="timeline-head">
                <span class="timeline-order mono">${entry.order + 1}</span>
                <span class="timeline-type">${esc(MISSION_STEP_LABELS[entry.type])}</span>
                <span class="timeline-loop">${esc(loopNote)}</span>
              </div>
              <p class="timeline-desc">${esc(entry.description)}</p>
              ${toolLine}
            </div>`;
              })
              .join('')
          : '<p class="clean-note">No mission steps authored yet. Add at least one step above to produce a timeline.</p>';
      }

      const summary = el('[data-observatory-summary]');
      if (summary) {
        const lines = [
          `Simulated tool calls: ${run.totalCostUnits}. This counts action steps in the run; it is not a real dollar cost. Stated cost ceiling: ${state.limits.costCeiling.trim() || 'not stated'}.`,
          run.haltedByLimit ? run.haltReason : 'No loop reached a limit in this run.',
          run.unauthorizedCount > 0
            ? `Failures: ${run.unauthorizedCount} unauthorized action step(s). See Risk flags below.`
            : 'Failures: none detected by these checks.',
          `Recovery. Tool failure: ${state.failure.onToolFailure.trim() || 'not stated'} Uncertainty: ${state.failure.onUncertainty.trim() || 'not stated'} Loop detected: ${state.failure.onLoopDetected.trim() || 'not stated'}`,
        ];
        summary.innerHTML = lines.map((line) => `<p class="observatory-line">${esc(line)}</p>`).join('');
      }
    }

    function renderSpecPreview(state: AgentSpecState) {
      const target = el<HTMLElement>('[data-spec-preview]');
      if (target) target.textContent = serialize(state, 'markdown');
    }

    function renderAll() {
      refreshStepOptions();
      const state = readState();
      renderReadyLine(state);
      renderCompleteness(state);
      renderFlags(state);
      renderObservatory(state);
      renderSpecPreview(state);
    }

    /* ---------------------------------------------------------------- *
     * Wiring
     * ---------------------------------------------------------------- */

    root.addEventListener('input', renderAll);
    root.addEventListener('change', (event) => {
      const target = event.target as HTMLElement;
      // Autonomy select changed: refresh its description line too.
      if (target.matches('[name="autonomy-level"]')) updateAutonomyDescription();
      // A tool's mutates checkbox governs whether irreversible is even
      // a meaningful question for that row.
      if (target instanceof HTMLInputElement && target.dataset.toolField === 'mutates') {
        const row = target.closest<HTMLElement>('[data-tool-row]');
        const irreversible = row?.querySelector<HTMLInputElement>('[data-tool-field="irreversible"]');
        if (irreversible) {
          irreversible.disabled = !target.checked;
          if (!target.checked) irreversible.checked = false;
        }
      }
      // A step's type governs whether the tool select is even a
      // meaningful question for that row: only an action step calls a
      // tool at all.
      if (target instanceof HTMLSelectElement && target.dataset.stepField === 'type') {
        const row = target.closest<HTMLElement>('[data-step-row]');
        const toolField = row?.querySelector<HTMLElement>('[data-step-tool-field]');
        const toolSelect = row?.querySelector<HTMLSelectElement>('[data-step-field="toolId"]');
        const isAction = target.value === 'action';
        if (toolField) toolField.hidden = !isAction;
        if (toolSelect) {
          toolSelect.disabled = !isAction;
          if (!isAction) toolSelect.value = '';
        }
      }
      renderAll();
    });

    root.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;

      if (target.closest('[data-remove-tool]')) {
        target.closest('[data-tool-row]')?.remove();
        renumberRows('[data-tool-row]', 'Tool');
        renderAll();
        return;
      }
      if (target.closest('[data-remove-handoff]')) {
        target.closest('[data-handoff-row]')?.remove();
        renumberRows('[data-handoff-row]', 'Handoff');
        renderAll();
        return;
      }
      if (target.closest('[data-remove-loop]')) {
        target.closest('[data-loop-row]')?.remove();
        renumberRows('[data-loop-row]', 'Loop');
        renderAll();
        return;
      }
      if (target.closest('[data-remove-step]')) {
        target.closest('[data-step-row]')?.remove();
        renumberRows('[data-step-row]', 'Step');
        renderAll();
        return;
      }
      if (target.closest('[data-remove-team]')) {
        target.closest('[data-team-row]')?.remove();
        renumberRows('[data-team-row]', 'Teammate');
        renderAll();
        return;
      }
    });

    function renumberRows(selector: string, label: string) {
      root.querySelectorAll<HTMLElement>(selector).forEach((row, i) => {
        const legend = row.querySelector('.row-legend');
        if (legend) legend.textContent = `${label} ${i + 1}`;
        const removeBtn = row.querySelector<HTMLButtonElement>('.row-remove');
        if (removeBtn) removeBtn.setAttribute('aria-label', `Remove ${label.toLowerCase()} ${i + 1}`);
      });
    }

    el('[data-add-tool]')?.addEventListener('click', () => {
      const tools = readTools();
      tools.push({
        id: nextId('tool'),
        name: '',
        input: '',
        output: '',
        mutates: false,
        irreversible: false,
        needsConfirmation: false,
      });
      renderToolRows(tools);
      renderAll();
    });

    el('[data-add-handoff]')?.addEventListener('click', () => {
      const handoffs = readHandoffs();
      handoffs.push({ id: nextId('handoff'), trigger: '', target: '', contextTransferred: '', owner: '' });
      renderHandoffRows(handoffs);
      renderAll();
    });

    el('[data-add-loop]')?.addEventListener('click', () => {
      const loops = readLoops();
      loops.push({ id: nextId('loop'), label: '', maxIterations: 0, exitCondition: '' });
      renderLoopRows(loops);
      renderAll();
    });

    el('[data-add-step]')?.addEventListener('click', () => {
      const steps = readSteps();
      steps.push({ id: nextId('step'), type: 'observation', description: '', toolId: '', loopId: '' });
      renderStepRows(steps, readTools(), readLoops());
      renderAll();
    });

    el('[data-add-team]')?.addEventListener('click', () => {
      const team = readTeam();
      team.push({ id: nextId('team'), name: '', role: '' });
      renderTeamRows(team);
      renderAll();
    });

    el('[data-load-sample]')?.addEventListener('click', () => {
      const id = el<HTMLSelectElement>('[data-sample-select]')?.value ?? SAMPLES[0].id;
      writeState(sampleState(id));
      const teaches = el('[data-teaches]');
      if (teaches) teaches.textContent = getSample(id)?.teaches ?? '';
      renderAll();
    });

    el('[data-reset]')?.addEventListener('click', () => {
      writeState(emptyState());
      const teaches = el('[data-teaches]');
      if (teaches) teaches.textContent = '';
      renderAll();
    });

    el('[data-copy-spec]')?.addEventListener('click', async () => {
      const text = serialize(readState(), 'markdown');
      try {
        await navigator.clipboard.writeText(text);
        const teaches = el('[data-teaches]');
        if (teaches) teaches.textContent = 'Specification copied to the clipboard.';
      } catch {
        const teaches = el('[data-teaches]');
        if (teaches) teaches.textContent = 'The browser blocked clipboard access.';
      }
    });

    // ExportBar asks; the tool answers. See src/components/kit/ExportBar.astro.
    root.addEventListener('workbench:export', ((event: CustomEvent) => {
      const { format, resolve } = event.detail ?? {};
      if (typeof resolve !== 'function') return;
      const fmt = format === 'markdown' ? 'markdown' : 'json';
      resolve(serialize(readState(), fmt));
    }) as EventListener);

    root.addEventListener('workbench:load-sample', () => {
      writeState(sampleState());
      renderAll();
    });

    // Start from the empty state so the empty case (zero tools, zero
    // handoffs, zero mission steps) renders its own list note rather
    // than nothing at all.
    writeState(emptyState());
    renderAll();
  }
</script>
