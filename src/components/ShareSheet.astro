---
// Share sheet. Native navigator.share where available (the real
// sharesheet on phones), with X, Facebook, and SMS intents as the
// universal row. All intent URLs are the platforms' own share
// endpoints; nothing is tracked, nothing loads from third parties.
interface Props {
  title: string;
  // Optional override; defaults to the current page URL at render time.
  url?: string;
}
const { title, url } = Astro.props;
const pageUrl = url ?? new URL(Astro.url.pathname, Astro.site).toString();
const enc = encodeURIComponent;
const shareText = `${title} · Nixfred AI Systems Workbench`;
---

<div class="sharesheet" data-share-url={pageUrl} data-share-title={shareText}>
  <span class="mono share-label">SHARE THIS</span>
  <div class="share-row">
    <button type="button" class="share-btn native-share" hidden>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12M12 3l-4 4M12 3l4 4M5 12v7h14v-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Share
    </button>
    <a class="share-btn" href={`https://twitter.com/intent/tweet?text=${enc(shareText)}&url=${enc(pageUrl)}`} target="_blank" rel="noopener">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      Post
    </a>
    <a class="share-btn" href={`https://www.facebook.com/sharer/sharer.php?u=${enc(pageUrl)}`} target="_blank" rel="noopener">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      Facebook
    </a>
    <a class="share-btn" href={`sms:?&body=${enc(`${shareText} ${pageUrl}`)}`}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 8.5-8.5 8.38 8.38 0 0 1 8.5 8.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Text
    </a>
  </div>
</div>

<script>
  // Reveal the native sharesheet button only where the API exists.
  document.querySelectorAll<HTMLElement>('.sharesheet').forEach((sheet) => {
    const btn = sheet.querySelector<HTMLButtonElement>('.native-share');
    if (!btn || !('share' in navigator)) return;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      navigator
        .share({
          title: sheet.dataset.shareTitle ?? document.title,
          url: sheet.dataset.shareUrl ?? location.href,
        })
        .catch(() => {
          /* User dismissed the native sheet. Nothing to recover. */
        });
    });
  });
</script>

<style>
  .sharesheet {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .share-label {
    display: block;
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    color: var(--text-faint);
    margin-bottom: var(--space-2);
  }

  .share-row { display: flex; gap: var(--space-2); flex-wrap: wrap; }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font: 600 var(--text-xs) var(--font-sans);
    letter-spacing: 0.04em;
    color: var(--text-muted);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.5rem 0.95rem;
    text-decoration: none;
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
  }

  .share-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
